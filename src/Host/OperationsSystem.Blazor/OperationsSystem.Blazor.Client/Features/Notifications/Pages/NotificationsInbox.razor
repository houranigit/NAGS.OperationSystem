@page "/notifications"

<PageTitle>Notifications</PageTitle>

<RequireAuth>
    <main class="os-list-page os-notifications-page" lang="en" dir="ltr">
        <PageHeader Title="Notifications">
            <Actions>
                @if (feed?.TotalCount > 0)
                {
                    <RowActionMenu Label="Notification actions" Busy="@isUpdating">
                        <RowAction Text="Delete all" Icon="delete_outline" Danger="true" OnClick="ArchiveAllAsync" />
                    </RowActionMenu>
                }
            </Actions>
        </PageHeader>

        @if (isLoading)
        {
            <LoadingCard Message="Loading notifications…" />
        }
        else if (loadError)
        {
            <ErrorState Message="We couldn't load your notifications." OnRetry="LoadAsync" />
        }
        else
        {
            @if (feed?.IsCached == true || feed?.HasPendingRead == true)
            {
                <div class="os-notifications-offline" role="status">
                    <RadzenIcon Icon="cloud_off" />
                    <span>Showing saved notifications. Read status will sync when connected.</span>
                    <button type="button" @onclick="LoadAsync">Refresh</button>
                </div>
            }
            @if (rows.Count == 0)
            {
                <EmptyState Icon="notifications_none" Title="You're all caught up"
                            Description="Your notifications will appear here." />
            }
            else
            {
                <section @ref="scrollElement" class="os-notifications-scroll" tabindex="0" aria-label="Notifications">
                    @foreach (var group in groups)
                    {
                        <section @key="group.Key" class="os-notification-group" aria-label="@group.Heading">
                            <h2>@group.Heading</h2>
                            <Virtualize @key="(group.Key, rowVersion)" Context="notification" Items="@group.Items" ItemSize="96" OverscanCount="3">
                                <ItemContent>
                                    <div @key="notification.Id" data-swipe-row data-notification-id="@notification.Id"
                                         class="os-notification-swipe" tabindex="0" aria-label="@($"{notification.TitleEn}. Swipe left to show Delete, or swipe fully left to delete.")">
                                        <button type="button" class="os-notification-delete" aria-label="@($"Delete {notification.TitleEn}")"
                                                disabled="@(busyNotificationId == notification.Id)" @onclick="() => BeginDeleteAsync(notification.Id)">Delete</button>
                                        <article class="os-notification-row @NotificationPresentation.ToneClass(notification) @(feed?.IsNew(notification) == true ? "os-notification-row--new" : null)">
                                            <span class="os-notification-row__icon"><RadzenIcon Icon="@NotificationPresentation.Icon(notification)" /></span>
                                            <span class="os-notification-row__copy">
                                                <strong>@notification.TitleEn</strong>
                                                <span class="os-notification-row__body">@notification.BodyEn<span class="os-notification-age-space">&nbsp;&nbsp;</span><time datetime="@notification.CreatedAtUtc.ToString("O")">@NotificationPresentation.RelativeAge(notification.CreatedAtUtc, DateTimeOffset.UtcNow)</time></span>
                                            </span>
                                            @if (Targets.IsOpenable(notification))
                                            {
                                                <button type="button" class="os-notification-open" @onclick="() => OpenAsync(notification)">Open</button>
                                            }
                                        </article>
                                    </div>
                                </ItemContent>
                                <Placeholder>
                                    <div class="os-notification-placeholder" aria-hidden="true"><span></span><span></span></div>
                                </Placeholder>
                            </Virtualize>
                        </section>
                    }
                    <div @ref="endSentinel" class="os-notifications-end" aria-hidden="true"></div>
                    @if (isLoadingMore)
                    {
                        <div class="os-notifications-paging" role="status">Loading…</div>
                    }
                    @if (pagingError)
                    {
                        <div class="os-notifications-paging" role="status">
                            <span>We couldn't load older notifications.</span>
                            <button type="button" @onclick="RetryOlderAsync">Retry</button>
                        </div>
                    }
                </section>
            }
        }
    </main>
</RequireAuth>

@page "/notifications"

<PageTitle>@UiStrings.Notifications.Title</PageTitle>

<RequireAuth>
    <main class="os-list-page os-notifications-page">
        <PageHeader Title="@UiStrings.Notifications.Title" Description="@UiStrings.Notifications.Description">
            <Actions>
                @if (feed?.TotalCount > 0)
                {
                    <RadzenButton Text="@UiStrings.Notifications.ArchiveAll" Icon="inventory_2" ButtonStyle="ButtonStyle.Light"
                                  Disabled="@isUpdating" Click="@ArchiveAllAsync" />
                }
            </Actions>
        </PageHeader>

        <nav class="os-notifications-categories" aria-label="@UiStrings.Notifications.Categories">
            @foreach (var category in NotificationCategories.All)
            {
                <button @key="category" type="button" class="@CategoryClass(category)"
                        aria-pressed="@(selectedCategory == category)" @onclick="() => SelectCategory(category)">
                    <span>@NotificationPresentation.CategoryLabel(category)</span>
                    @if (CategoryNewCount(category) > 0)
                    {
                        <span class="os-notifications-category__count" aria-label="@string.Format(UiStrings.Notifications.NewCount, CategoryNewCount(category))">@CategoryNewCount(category)</span>
                    }
                </button>
            }
        </nav>

        @if (isLoading)
        {
            <LoadingCard Message="@UiStrings.Common.Loading" />
        }
        else if (loadError)
        {
            <ErrorState Message="@UiStrings.Notifications.LoadFailed" OnRetry="@LoadAsync" />
        }
        else
        {
            @if (feed?.IsCached == true || feed?.HasPendingRead == true)
            {
                <div class="os-notifications-offline" role="status">
                    <RadzenIcon Icon="cloud_off" />
                    <span>@UiStrings.Notifications.CachedDescription</span>
                    <button type="button" @onclick="LoadAsync">@UiStrings.Common.Refresh</button>
                </div>
            }
            @if (feed?.TotalCount == 0)
            {
                <EmptyState Icon="notifications_none" Title="@UiStrings.Notifications.EmptyTitle"
                            Description="@UiStrings.Notifications.EmptyDescription" />
            }
            else
            {
                <section class="os-notifications-scroll" tabindex="0" aria-label="@NotificationPresentation.CategoryLabel(selectedCategory)">
                    <Virtualize @key="visitGeneration" @ref="virtualList" Context="notification" ItemsProvider="ProvideItems"
                                ItemSize="128" OverscanCount="3">
                        <ItemContent>
                            <article @key="notification.Id" class="os-notification-row @(feed?.IsNew(notification) == true ? "os-notification-row--new" : null)">
                                <button type="button" class="os-notification-row__main" @onclick="() => OpenAsync(notification)">
                                    <span class="os-notification-row__icon"><RadzenIcon Icon="@NotificationPresentation.Icon(notification)" /></span>
                                    <span class="os-notification-row__copy">
                                        <span class="os-notification-row__meta">
                                            <span>@NotificationPresentation.KindLabel(notification)</span>
                                            <time datetime="@notification.CreatedAtUtc.ToString("O")" title="@($"{UserTimeZone.Format(notification.CreatedAtUtc, "F")} ({UserTimeZone.Id})")">
                                                @RelativeTime(notification.CreatedAtUtc)
                                            </time>
                                        </span>
                                        <strong>@NotificationPresentation.Title(notification, Locale)</strong>
                                        <span class="os-notification-row__body">@NotificationPresentation.Body(notification, Locale)</span>
                                    </span>
                                    <RadzenIcon class="os-notification-row__arrow" Icon="@(Locale.IsRightToLeft ? "chevron_left" : "chevron_right")" />
                                </button>
                                <button type="button" class="os-notification-row__archive" title="@UiStrings.Notifications.Archive"
                                        aria-label="@($"{UiStrings.Notifications.Archive}: {NotificationPresentation.Title(notification, Locale)}")"
                                        disabled="@(busyNotificationId == notification.Id)" @onclick="() => ArchiveAsync(notification)">
                                    <RadzenIcon Icon="inventory_2" />
                                </button>
                            </article>
                        </ItemContent>
                        <Placeholder>
                            <div class="os-notification-placeholder" aria-hidden="true"><span></span><span></span></div>
                        </Placeholder>
                    </Virtualize>
                </section>
            }
        }
    </main>
</RequireAuth>

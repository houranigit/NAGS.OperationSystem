@page "/account/notifications"

<PageTitle>Notification settings</PageTitle>

<RequireAuth>
    @if (Auth.User is { } user)
    {
        <main class="os-list-page" lang="en" dir="ltr">
            <PageHeader Title="Notification settings" ParentTitle="@UiStrings.Account.Title" ParentHref="/account" />

            <div class="notification-preferences">
                @if (isLoading)
                {
                    <LoadingCard Message="Loading your notification preferences…" />
                }
                else if (preferences is null)
                {
                    <ErrorState Message="We couldn't load your notification preferences." OnRetry="LoadAsync" />
                }
                else
                {
                    <section class="notification-preferences-group" aria-label="Notifications">
                        <div class="notification-preferences-rows">
                            <button type="button" class="notification-preferences-row" role="switch" aria-checked="@(preferences.Enabled ? "true" : "false")"
                                    disabled="@(savingKey is not null)" @onclick='() => SaveAsync("enabled", !preferences.Enabled)'>
                                <span class="notification-preferences-copy"><strong>Allow notifications</strong><span>Pause or resume notifications for your account.</span></span>
                                <span class="notification-preferences-switch" aria-hidden="true"></span>
                            </button>
                        </div>
                    </section>

                    @foreach (var group in Groups)
                    {
                        <section @key="group.Title" class="notification-preferences-group" aria-label="@group.Title">
                            <h2>@group.Title</h2>
                            <div class="notification-preferences-rows">
                                @foreach (var option in group.Options)
                                {
                                    <button @key="option.Key" type="button" class="notification-preferences-row" role="switch"
                                            aria-checked="@(option.Value(preferences) ? "true" : "false")"
                                            disabled="@(savingKey is not null || !preferences.Enabled)"
                                            @onclick="() => SaveAsync(option.Key, !option.Value(preferences))">
                                        <span class="notification-preferences-copy"><strong>@option.Title</strong><span>@option.Description</span></span>
                                        <span class="notification-preferences-switch" aria-hidden="true"></span>
                                    </button>
                                }
                            </div>
                        </section>
                    }

                }

                @if (!isLoading)
                {
                    <section class="notification-preferences-group" aria-labelledby="notification-email-heading">
                        <h2 id="notification-email-heading" dir="auto">@UiStrings.Notifications.EmailPreferences</h2>
                        <div class="notification-preferences-rows">
                            <button type="button" class="notification-preferences-row" role="switch"
                                    aria-checked="@(user.ReceiveWorkOrderSubmissionEmails ? "true" : "false")"
                                    disabled="@(savingKey is not null || !workOrderEmailLoaded || workOrderEmailError is not null)"
                                    @onclick="() => SaveAsync(WorkOrderEmailKey, !user.ReceiveWorkOrderSubmissionEmails)">
                                <span class="notification-preferences-copy" dir="auto">
                                    <strong>@UiStrings.Notifications.WorkOrderEmailPreference</strong>
                                    <span>@string.Format(UiStrings.Notifications.WorkOrderEmailPreferenceHint, user.Email)</span>
                                </span>
                                <span class="notification-preferences-switch" aria-hidden="true"></span>
                            </button>
                        </div>
                        @if (workOrderEmailError is not null)
                        {
                            <div class="notification-preferences-feedback" role="status" dir="auto">
                                <span class="notification-preferences-error">@workOrderEmailError</span>
                                <button type="button" disabled="@(savingKey is not null)" @onclick="LoadAsync">@UiStrings.Notifications.EmailPreferenceRefresh</button>
                            </div>
                        }
                    </section>

                    <div class="notification-preferences-feedback" role="status" aria-live="polite">
                        @if (savingKey is not null)
                        {
                            <span>Saving preference…</span>
                        }
                        else if (failedChange is not null)
                        {
                            <span class="notification-preferences-error">We couldn't confirm this change. Your last loaded preference is still shown.</span>
                            <button type="button" @onclick="RetrySaveAsync">Try again</button>
                        }
                        else if (saved)
                        {
                            <span>Preference saved.</span>
                        }
                    </div>
                    <p class="notification-preferences-note">Changes apply to future notifications across your account. Existing notifications stay in your inbox. Android alerts also depend on your device's notification permission.</p>
                }
            </div>
        </main>
    }
</RequireAuth>

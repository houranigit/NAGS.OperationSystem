@implements IAsyncDisposable
@inject NotificationCenterState Center
@inject LocaleState Locale
@inject UserTimeZone UserTimeZone
@inject NavigationManager Navigation
@inject NotificationService Toasts
@inject NotificationTargetAvailability Targets

<div class="os-notification-bell @(isOpen ? "os-notification-bell--open" : null)">
    <button type="button" class="os-notification-bell__trigger" title="Notifications"
            aria-label="Open notifications" aria-haspopup="true" aria-expanded="@isOpen"
            @onclick="ToggleAsync">
        <RadzenIcon Icon="notifications_none" />
        @if (Center.UnreadCount > 0)
        {
            <span class="os-notification-bell__badge" aria-label="@($"{Center.UnreadCount} unread")">
                @(Center.UnreadCount > 99 ? "99+" : Center.UnreadCount.ToString())
            </span>
        }
    </button>

    @if (isOpen)
    {
        <button type="button" class="os-notification-bell__backdrop" aria-label="@UiStrings.Common.Close" @onclick="Close"></button>
        <section class="os-notification-bell__panel" aria-label="Recent notifications" lang="en" dir="ltr">
            <header class="os-notification-bell__header">
                <div>
                    <strong>Notifications</strong>
                    @if (Center.UnreadCount > 0)
                    {
                        <small>@($"{Center.UnreadCount} unread")</small>
                    }
                </div>
            </header>

            <div class="os-notification-bell__content">
                @if (Center.IsLoading || !UserTimeZone.IsInitialized)
                {
                    @for (var index = 0; index < 3; index++)
                    {
                        <div class="os-notification-bell__skeleton" @key="index">
                            <span></span><span></span><span></span>
                        </div>
                    }
                }
                else if (Center.HasError)
                {
                    <div class="os-notification-bell__state">
                        <span class="os-notification-bell__state-icon"><RadzenIcon Icon="cloud_off" /></span>
                        <strong>We couldn't load your notifications.</strong>
                        <small>Refresh to check for recent notifications.</small>
                        <button type="button" @onclick="RefreshAsync">Refresh</button>
                    </div>
                }
                else if (Center.Recent.Count == 0)
                {
                    <div class="os-notification-bell__state">
                        <span class="os-notification-bell__state-icon os-notification-bell__state-icon--success"><RadzenIcon Icon="done_all" /></span>
                        <strong>You're all caught up</strong>
                        <small>Your notifications will appear here.</small>
                    </div>
                }
                else
                {
                    @foreach (var notification in Center.Recent)
                    {
                        <article @key="notification.Id"
                                 class="os-notification-bell__item @NotificationPresentation.ToneClass(notification) @(!notification.IsRead ? "os-notification-bell__item--unread" : null)">
                            <span class="os-notification-bell__item-icon"><RadzenIcon Icon="@NotificationPresentation.Icon(notification)" /></span>
                            <span class="os-notification-bell__item-copy">
                                <strong>@NotificationPresentation.Title(notification, Locale)</strong>
                                <span>@NotificationPresentation.Body(notification, Locale)&nbsp;&nbsp;<time datetime="@notification.CreatedAtUtc.ToString("O")">@NotificationPresentation.RelativeAge(notification.CreatedAtUtc, DateTimeOffset.UtcNow)</time></span>
                            </span>
                            @if (Targets.IsOpenable(notification))
                            {
                                <button type="button" class="os-notification-bell__open" @onclick="() => OpenAsync(notification)">Open</button>
                            }
                        </article>
                    }
                }
            </div>

            <footer class="os-notification-bell__footer">
                <button type="button" @onclick="ViewAll">
                    <span>View all notifications</span>
                    <RadzenIcon Icon="arrow_forward" />
                </button>
            </footer>
        </section>
    }
</div>

@code {
    private bool isOpen;
    private bool disposed;
    private readonly CancellationTokenSource lifetimeCts = new();

    protected override void OnInitialized() => Center.Changed += OnCenterChanged;

    protected override async Task OnInitializedAsync() => await UserTimeZone.InitializeAsync();

    private async Task ToggleAsync()
    {
        isOpen = !isOpen;
        if (isOpen)
        {
            await Center.RefreshAsync(lifetimeCts.Token);
            await Targets.CheckAsync(Center.Recent, lifetimeCts.Token);
        }
    }

    private void Close() => isOpen = false;

    private async Task RefreshAsync()
    {
        await Center.RefreshAsync(lifetimeCts.Token);
        await Targets.CheckAsync(Center.Recent, lifetimeCts.Token);
    }

    private async Task OpenAsync(NotificationDto notification)
    {
        try { await Targets.CheckAsync([notification], lifetimeCts.Token, force: true); }
        catch (OperationCanceledException) when (lifetimeCts.IsCancellationRequested) { return; }
        if (!Targets.IsOpenable(notification))
            return;
        if (!notification.IsRead)
        {
            try
            {
                using var readCts = CancellationTokenSource.CreateLinkedTokenSource(lifetimeCts.Token);
                readCts.CancelAfter(TimeSpan.FromSeconds(5));
                await Center.MarkAsReadAsync(notification.Id, readCts.Token);
            }
            catch (Exception)
            {
                Toasts.Notify(NotificationSeverity.Error, "Notifications", "The notification could not be updated. Please try again.");
            }
        }

        if (disposed)
            return;
        isOpen = false;
        Navigation.NavigateTo(NotificationPresentation.DeepLink(notification) ?? NotificationPresentation.InboxLink(notification));
    }

    private void ViewAll()
    {
        isOpen = false;
        Navigation.NavigateTo("/notifications");
    }

    private async void OnCenterChanged()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (disposed) return;
                if (isOpen) await Targets.CheckAsync(Center.Recent, lifetimeCts.Token);
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (lifetimeCts.IsCancellationRequested) { }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    public ValueTask DisposeAsync()
    {
        disposed = true;
        Center.Changed -= OnCenterChanged;
        lifetimeCts.Cancel();
        lifetimeCts.Dispose();
        return ValueTask.CompletedTask;
    }
}

<label>
    <span>@Label @if (Required) { <span aria-hidden="true">*</span> }</span>
    <RadzenDropDown TValue="Guid?" Data="@PortalWorkLookups.WithSaved(Options, SavedId, SavedName)"
                    TextProperty="@nameof(PortalCatalogChoice.Label)" ValueProperty="@nameof(PortalCatalogChoice.Id)"
                    Value="@Value" ValueChanged="@ValueChanged" AllowFiltering="true" AllowClear="@AllowClear"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Disabled="@Disabled"
                    aria-label="@Label" aria-invalid="@Validation.InvalidAttribute(Field)"
                    aria-describedby="@Validation.DescriptionId(Field)" />
    <PortalFieldError Validation="@Validation" Field="@Field" />
</label>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = default!;
    [Parameter, EditorRequired] public string Field { get; set; } = default!;
    [Parameter, EditorRequired] public PortalFlightValidation Validation { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<PortalCatalogChoice> Options { get; set; } = [];
    [Parameter] public Guid? Value { get; set; }
    [Parameter] public EventCallback<Guid?> ValueChanged { get; set; }
    [Parameter] public Guid? SavedId { get; set; }
    [Parameter] public string? SavedName { get; set; }
    [Parameter] public bool Required { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AllowClear { get; set; }
}

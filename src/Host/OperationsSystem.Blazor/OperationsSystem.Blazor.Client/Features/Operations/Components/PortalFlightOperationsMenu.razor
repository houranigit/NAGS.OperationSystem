@inject OperationsApiClient Operations
@inject AuthSession Auth
@inject ContextMenuService ContextMenu
@inject DialogService Dialogs
@inject NotificationService Notifications

@if (ShowDivider)
{
    <div class="os-row-actions-sep" role="separator"></div>
}
@if (isLoading)
{
    <div class="os-row-actions-note" role="status">Loading flight actions…</div>
}
else if (loadError)
{
    <button type="button" role="menuitem" class="os-row-actions-item" @onclick="LoadAsync">
        <RadzenIcon Icon="refresh" /><span>Retry flight actions</span>
    </button>
}
@if (details is { } flight && cancellations.Count > 0)
{
    <RowActionSubmenu Text="Cancellation order" Icon="event_busy">
        @foreach (var cancellation in cancellations)
        {
            var reporterLabel = cancellations.Count > 1
                ? cancellation.SubmittedByEmployee is { } employee
                    ? $"{employee.FullName} · {employee.EmployeeId}"
                    : cancellation.SubmitterName
                : null;
            @if (reporterLabel is not null)
            {
                <div class="os-row-actions-note">@reporterLabel</div>
            }
            <button @key="cancellation.Id" type="button" role="menuitem" class="os-row-actions-item"
                    aria-label="@(reporterLabel is null ? null : $"View cancellation by {reporterLabel}")"
                    @onclick="@(() => OpenCancellationAsync(cancellation.Id))">
                <RadzenIcon Icon="visibility" /><span>View</span>
            </button>
            @if (CanUndoCancellation(cancellation))
            {
                <button type="button" role="menuitem" class="os-row-actions-item os-row-actions-item--danger"
                        @onclick="@(() => UndoCancellationAsync(cancellation, flight.RowVersion))">
                    <RadzenIcon Icon="undo" /><span>Undo</span>
                </button>
            }
        }
    </RowActionSubmenu>
}
<RowActionSubmenu Text="Work Order" Icon="assignment">
    @{
        var review = ReviewAction(details);
    }
    @if (details is { } work && CanViewWorkOrder(work))
    {
        <button type="button" role="menuitem" class="os-row-actions-item" @onclick="OpenWorkAsync">
            <RadzenIcon Icon="visibility" /><span>View</span>
        </button>
    }
    @if (review != PortalFlightWorkDialog.ApprovalAction.None)
    {
        var unlock = review == PortalFlightWorkDialog.ApprovalAction.Unlock;
        <button type="button" role="menuitem" class="os-row-actions-item" @onclick="@(() => OpenApprovalAsync(review))">
            <RadzenIcon Icon="@(unlock ? "lock_open" : "verified")" /><span>@(unlock ? "Unlock" : "Approve")</span>
        </button>
    }
    <button type="button" role="menuitem" class="os-row-actions-item" disabled="@printing" @onclick="PrintWorkOrderAsync">
        <RadzenIcon Icon="print" /><span>@UiStrings.Flights.PrintWorkOrder</span>
    </button>
</RowActionSubmenu>
@if (details is { } cancellable && CanStartCancellation(cancellable))
{
    <button type="button" role="menuitem" class="os-row-actions-item os-row-actions-item--danger"
            @onclick="@(() => OpenCancellationAsync(null))">
        <RadzenIcon Icon="cancel" /><span>Cancel flight</span>
    </button>
}

@code {
    [Parameter, EditorRequired] public Guid FlightId { get; set; }
    [Parameter] public bool ShowWorkActions { get; set; }
    [Parameter] public bool ShowDivider { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    private PortalFlightOperations? details;
    private IReadOnlyList<PortalFlightCancellation> cancellations = [];
    private bool hasSavedWork;
    private bool isLoading;
    private bool loadError;
    private bool printing;

    private bool CanOperateAsAdministrator => Auth.IsSystemAdministrator &&
        Auth.HasPermission(OperationsPermissions.FlightsView) && Auth.HasPermission(OperationsPermissions.FlightsOperate);
    private bool ViewOnly => Auth.IsSystemAdministrator
        ? !CanOperateAsAdministrator
        : !Auth.HasPermission(OperationsPermissions.FlightsOperate);

    protected override Task OnInitializedAsync() => ShowWorkActions ? LoadAsync() : Task.CompletedTask;

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = false;
        try
        {
            var flight = await Operations.GetPortalFlightOperationsAsync(FlightId);
            details = flight;
            var staffId = flight.CurrentStaffMemberId;
            var isAdministrator = Auth.IsSystemAdministrator;
            cancellations = isAdministrator ? flight.CancellationSubmissions : flight.CancellationSubmissions
                .Where(item => staffId.HasValue && item.SubmittedByEmployee?.StaffMemberId == staffId).ToArray();
            var userId = Auth.User?.Id;
            hasSavedWork = flight.ArrivalSubmissions.Any(item => isAdministrator || staffId.HasValue && item.SubmittedByEmployee?.StaffMemberId == staffId)
                || flight.DepartureSubmissions.Any(item => isAdministrator || staffId.HasValue && item.SubmittedByEmployee?.StaffMemberId == staffId)
                || flight.Services.Any(item => isAdministrator || item.CreatedByUserId == userId)
                || flight.Tasks.Any(item => isAdministrator || item.CreatedByUserId == userId)
                || flight.ReturnToRamps.Any(item => isAdministrator || item.CreatedByUserId == userId);
        }
        catch (ApiException ex) when (ex.IsForbidden || ex.IsNotFound)
        {
            details = null;
        }
        catch (ApiException)
        {
            loadError = true;
        }
        catch (JSException)
        {
            loadError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static bool CanOpenWork(PortalFlightOperations flight) =>
        flight.CanSaveArrival || flight.CanSaveDeparture || flight.CanSaveServices || flight.CanSaveTasks || flight.CanSaveReturnsToRamp;

    private bool CanViewWorkOrder(PortalFlightOperations flight) =>
        ReviewAction(flight) != PortalFlightWorkDialog.ApprovalAction.None ||
        (Auth.IsSystemAdministrator || cancellations.Count == 0) && (hasSavedWork || CanOpenWork(flight));

    private static PortalFlightWorkDialog.ApprovalAction ReviewAction(PortalFlightOperations? flight) => flight switch
    {
        { CanUnlock: true } => PortalFlightWorkDialog.ApprovalAction.Unlock,
        { CanApprove: true } => PortalFlightWorkDialog.ApprovalAction.Approve,
        _ => PortalFlightWorkDialog.ApprovalAction.None
    };

    private bool CanStartCancellation(PortalFlightOperations flight) => !flight.IsApprovalLocked &&
        flight.CanSaveCancellation && cancellations.Count == 0 &&
        (Auth.IsSystemAdministrator ? CanOperateAsAdministrator : !hasSavedWork);

    private bool CanUndoCancellation(PortalFlightCancellation report) => details is { IsApprovalLocked: false } &&
        (Auth.IsSystemAdministrator
        ? CanOperateAsAdministrator && report.IsAccountSubmissionBy(Auth.User?.Id)
        : details.CurrentStaffMemberId is { } staffId && report.SubmittedByEmployee?.StaffMemberId == staffId);

    private Task OpenWorkAsync() => details is { } flight && CanViewWorkOrder(flight)
        ? OpenWorkDialogAsync(flight, PortalFlightWorkDialog.ApprovalAction.None)
        : Task.CompletedTask;

    private Task OpenApprovalAsync(PortalFlightWorkDialog.ApprovalAction review) =>
        details is { } flight && review == ReviewAction(flight) && review != PortalFlightWorkDialog.ApprovalAction.None
            ? OpenWorkDialogAsync(flight, review)
            : Task.CompletedTask;

    private async Task OpenWorkDialogAsync(PortalFlightOperations flight, PortalFlightWorkDialog.ApprovalAction review)
    {
        ContextMenu.Close();
        var title = review switch
        {
            PortalFlightWorkDialog.ApprovalAction.Approve => "Approve work order",
            PortalFlightWorkDialog.ApprovalAction.Unlock => "Unlock work order",
            _ => "Work order"
        };
        var result = await Dialogs.OpenAsync<PortalFlightWorkDialog>($"{title} · {flight.FlightNumber}",
            new()
            {
                [nameof(PortalFlightWorkDialog.FlightId)] = FlightId,
                [nameof(PortalFlightWorkDialog.ViewOnly)] = ViewOnly,
                [nameof(PortalFlightWorkDialog.AdministratorEntry)] = CanOperateAsAdministrator,
                [nameof(PortalFlightWorkDialog.ReviewAction)] = review
            },
            PortalWorkDialogLayout.CreateOptions());
        if (result is true)
            await Changed.InvokeAsync();
    }

    private async Task PrintWorkOrderAsync()
    {
        if (printing)
            return;

        printing = true;
        ContextMenu.Close();
        try
        {
            await Operations.DownloadPortalWorkOrderAsync(FlightId);
        }
        catch (ApiException ex)
        {
            Notifications.Notify(NotificationSeverity.Error, ex.ToDisplayMessage("Could not download the work order PDF."));
        }
        catch (JSException)
        {
            Notifications.Notify(NotificationSeverity.Error, "Could not download the work order PDF. Try again.");
        }
        finally
        {
            printing = false;
        }
    }

    private async Task OpenCancellationAsync(Guid? submissionId)
    {
        if (submissionId is null && (details is not { } flight || !CanStartCancellation(flight)))
            return;

        ContextMenu.Close();
        var result = await Dialogs.OpenAsync<PortalFlightCancellationDialog>(
            submissionId is null ? "Cancel flight" : "Cancellation order",
            new()
            {
                [nameof(PortalFlightCancellationDialog.FlightId)] = FlightId,
                [nameof(PortalFlightCancellationDialog.SubmissionId)] = submissionId,
                [nameof(PortalFlightCancellationDialog.ViewOnly)] = ViewOnly,
                [nameof(PortalFlightCancellationDialog.AdministratorEntry)] = CanOperateAsAdministrator
            },
            EditorOptions());
        if (result is true)
            await Changed.InvokeAsync();
    }

    private async Task UndoCancellationAsync(PortalFlightCancellation report, string rowVersion)
    {
        if (!CanUndoCancellation(report))
            return;

        ContextMenu.Close();
        if (!await PortalFlightCancellationDialog.ConfirmUndoAsync(Dialogs))
            return;

        try
        {
            await Operations.UndoPortalCancellationAsync(FlightId, report.Id, rowVersion);
            Notifications.Notify(NotificationSeverity.Success, "Cancellation undone");
            await Changed.InvokeAsync();
        }
        catch (ApiException ex)
        {
            Notifications.Notify(NotificationSeverity.Error, ex.ToDisplayMessage("Could not undo the cancellation. Reopen the flight actions and try again."));
        }
        catch (JSException)
        {
            Notifications.Notify(NotificationSeverity.Error, "Could not reach the server. Reopen the flight actions and check the cancellation.");
        }
    }

    private static DialogOptions EditorOptions(string width = "760px", string? height = null) =>
        new() { Width = width, Height = height, CloseDialogOnOverlayClick = false, CloseDialogOnEsc = false, ShowClose = false };
}

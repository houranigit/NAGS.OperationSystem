@inject OperationsApiClient Operations
@inject AuthSession Auth
@inject ContextMenuService ContextMenu
@inject DialogService Dialogs
@inject NotificationService Notifications

@if (ShowDivider && (isLoading || loadError || HasOrders || CanCreateWorkOrder || CanStartCancellation))
{
    <div class="os-row-actions-sep" role="separator"></div>
}
@if (isLoading)
{
    <div class="os-row-actions-note" role="status">Loading flight actions…</div>
}
else if (loadError)
{
    <button type="button" role="menuitem" class="os-row-actions-item" @onclick="LoadAsync">
        <RadzenIcon Icon="refresh" /><span>Retry flight actions</span>
    </button>
}
@if (!isLoading && HasOrders)
{
    @if (HasWorkOrder)
    {
        @OrderMenu(PortalFlightOrderKind.WorkOrder)
    }
    @if (HasCancellationOrder)
    {
        @OrderMenu(PortalFlightOrderKind.CancellationOrder)
    }
}
else if (!isLoading && !loadError)
{
    @if (CanCreateWorkOrder)
    {
        <button type="button" role="menuitem" class="os-row-actions-item" @onclick="CreateWorkOrderAsync">
            <RadzenIcon Icon="assignment" /><span>Create Work Order</span>
        </button>
    }
    @if (CanStartCancellation)
    {
        <button type="button" role="menuitem" class="os-row-actions-item os-row-actions-item--danger"
                @onclick="StartCancellationAsync">
            <RadzenIcon Icon="cancel" /><span>Cancel flight</span>
        </button>
    }
    @if (!ShowDivider && !CanCreateWorkOrder && !CanStartCancellation)
    {
        <div class="os-row-actions-note">No flight actions available</div>
    }
}

@code {
    [Parameter, EditorRequired] public FlightListItem Flight { get; set; } = default!;
    [Parameter] public bool ShowWorkActions { get; set; }
    [Parameter] public bool ShowDivider { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    private PortalFlightOperations? details;
    private bool isLoading;
    private bool loadError;
    private bool printing;

    private bool CanOperateAsAdministrator => Auth.IsSystemAdministrator &&
        Auth.HasPermission(OperationsPermissions.FlightsView) && Auth.HasPermission(OperationsPermissions.FlightsOperate);
    private bool ViewOnly => Auth.IsSystemAdministrator
        ? !CanOperateAsAdministrator
        : !Auth.HasPermission(OperationsPermissions.FlightsOperate);
    private bool HasOrders => HasWorkOrder || HasCancellationOrder;
    private bool HasWorkOrder => details is { } current
        ? current.IsAutoClosed || current.HasWorkOrderRecords
        : Flight.IsAutoClosed || (Flight.HasOperationalRecords && (!Flight.HasCancellationSubmission || Flight.Status == "Conflict"));
    private bool HasCancellationOrder => details is { } current
        ? current.CancellationSubmissions.Count > 0
        : Flight.HasCancellationSubmission;
    private bool CanCreateWorkOrder => !HasOrders && !ViewOnly && details is { } current &&
        (current.CanSaveArrival || current.CanSaveDeparture || current.CanSaveServices || current.CanSaveTasks || current.CanSaveReturnsToRamp);
    private bool CanStartCancellation => !HasOrders && !ViewOnly &&
        details is { IsApprovalLocked: false, CanSaveCancellation: true };
    private bool CanViewCancellation => details is { CancellationSubmissions.Count: > 0 } current &&
        (Auth.IsSystemAdministrator || current.CanApprove || current.CanUnlock ||
            current.CurrentStaffMemberId is { } staffId && current.CancellationSubmissions.Any(
                item => item.SubmittedByEmployee?.StaffMemberId == staffId));

    private PortalFlightWorkDialog.ApprovalAction ReviewAction => details switch
    {
        { CanUnlock: true } => PortalFlightWorkDialog.ApprovalAction.Unlock,
        { CanApprove: true } when !(HasWorkOrder && HasCancellationOrder) => PortalFlightWorkDialog.ApprovalAction.Approve,
        _ => PortalFlightWorkDialog.ApprovalAction.None
    };

    private RenderFragment OrderMenu(PortalFlightOrderKind kind) =>
        @<RowActionSubmenu Text="@(kind == PortalFlightOrderKind.WorkOrder ? "Work Order" : "Cancellation Order")"
                          Icon="@(kind == PortalFlightOrderKind.WorkOrder ? "assignment" : "event_busy")">
            @if (kind == PortalFlightOrderKind.WorkOrder ? details is not null : CanViewCancellation)
            {
                <button type="button" role="menuitem" class="os-row-actions-item" @onclick="@(() => ViewOrderAsync(kind))">
                    <RadzenIcon Icon="visibility" /><span>View</span>
                </button>
            }
            @if (ReviewAction != PortalFlightWorkDialog.ApprovalAction.None &&
                (kind == PortalFlightOrderKind.WorkOrder || !HasWorkOrder))
            {
                var unlock = ReviewAction == PortalFlightWorkDialog.ApprovalAction.Unlock;
                <button type="button" role="menuitem" class="os-row-actions-item" @onclick="@(() => OpenReviewAsync(kind))">
                    <RadzenIcon Icon="@(unlock ? "lock_open" : "verified")" /><span>@(unlock ? "Unlock" : "Approve")</span>
                </button>
            }
            <button type="button" role="menuitem" class="os-row-actions-item" disabled="@printing" @onclick="PrintWorkOrderAsync">
                <RadzenIcon Icon="print" /><span>@UiStrings.Flights.PrintWorkOrder</span>
            </button>
            @if (PortalOrderDeletion.CanDelete(Auth, details, kind))
            {
                <button type="button" role="menuitem" class="os-row-actions-item os-row-actions-item--danger"
                        @onclick="@(() => DeleteOrderAsync(kind))">
                    <RadzenIcon Icon="delete_outline" /><span>Delete</span>
                </button>
            }
        </RowActionSubmenu>;

    protected override Task OnInitializedAsync() => ShowWorkActions ? LoadAsync() : Task.CompletedTask;

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = false;
        try
        {
            details = await Operations.GetPortalFlightOperationsAsync(Flight.Id);
        }
        catch (ApiException ex) when (ex.IsForbidden || ex.IsNotFound)
        {
            details = null;
        }
        catch (ApiException)
        {
            loadError = true;
        }
        catch (JSException)
        {
            loadError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task CreateWorkOrderAsync() => CanCreateWorkOrder && details is { } flight
        ? OpenWorkDialogAsync(flight, PortalFlightWorkDialog.ApprovalAction.None)
        : Task.CompletedTask;

    private Task ViewOrderAsync(PortalFlightOrderKind kind)
    {
        if (kind == PortalFlightOrderKind.CancellationOrder)
            return CanViewCancellation
                ? OpenCancellationDialogAsync(PortalFlightWorkDialog.ApprovalAction.None, viewReports: true)
                : Task.CompletedTask;

        return HasWorkOrder && details is { } flight
            ? OpenWorkDialogAsync(flight, PortalFlightWorkDialog.ApprovalAction.None)
            : Task.CompletedTask;
    }

    private Task OpenReviewAsync(PortalFlightOrderKind kind)
    {
        var review = ReviewAction;
        if (details is not { } flight || review == PortalFlightWorkDialog.ApprovalAction.None)
            return Task.CompletedTask;

        return kind == PortalFlightOrderKind.WorkOrder
            ? OpenWorkDialogAsync(flight, review)
            : OpenCancellationDialogAsync(review);
    }

    private async Task OpenWorkDialogAsync(PortalFlightOperations flight, PortalFlightWorkDialog.ApprovalAction review)
    {
        ContextMenu.Close();
        var title = review switch
        {
            PortalFlightWorkDialog.ApprovalAction.Approve => "Approve work order",
            PortalFlightWorkDialog.ApprovalAction.Unlock => "Unlock work order",
            _ => "Work order"
        };
        var result = await Dialogs.OpenAsync<PortalFlightWorkDialog>($"{title} · {flight.FlightNumber}",
            new()
            {
                [nameof(PortalFlightWorkDialog.FlightId)] = Flight.Id,
                [nameof(PortalFlightWorkDialog.ViewOnly)] = ViewOnly,
                [nameof(PortalFlightWorkDialog.AdministratorEntry)] = CanOperateAsAdministrator,
                [nameof(PortalFlightWorkDialog.ReviewAction)] = review
            },
            PortalWorkDialogLayout.CreateOptions());
        if (result is true)
            await Changed.InvokeAsync();
    }

    private async Task PrintWorkOrderAsync()
    {
        if (printing)
            return;

        printing = true;
        ContextMenu.Close();
        try
        {
            await Operations.DownloadPortalWorkOrderAsync(Flight.Id);
        }
        catch (ApiException ex)
        {
            Notifications.Notify(NotificationSeverity.Error, ex.ToDisplayMessage("Could not download the work order PDF."));
        }
        catch (JSException)
        {
            Notifications.Notify(NotificationSeverity.Error, "Could not download the work order PDF. Try again.");
        }
        finally
        {
            printing = false;
        }
    }

    private async Task DeleteOrderAsync(PortalFlightOrderKind kind)
    {
        if (!PortalOrderDeletion.CanDelete(Auth, details, kind) || details is not { } flight)
            return;

        ContextMenu.Close();
        if (!await PortalOrderDeletion.ConfirmAsync(Dialogs, kind, flight.FlightNumber))
            return;

        try
        {
            await Operations.DeletePortalOrderAsync(Flight.Id, kind, flight.RowVersion);
            Notifications.Notify(NotificationSeverity.Success,
                kind == PortalFlightOrderKind.WorkOrder ? "Work order deleted" : "Cancellation order deleted");
            await Changed.InvokeAsync();
        }
        catch (ApiException ex)
        {
            Notifications.Notify(NotificationSeverity.Error, ex.ToDisplayMessage("Could not delete the order."));
        }
        catch (JSException)
        {
            Notifications.Notify(NotificationSeverity.Error, "Could not confirm the deletion. Reopen the flight to check its status.");
        }
    }

    private Task StartCancellationAsync() => CanStartCancellation
        ? OpenCancellationDialogAsync(PortalFlightWorkDialog.ApprovalAction.None)
        : Task.CompletedTask;

    private async Task OpenCancellationDialogAsync(PortalFlightWorkDialog.ApprovalAction review, bool viewReports = false)
    {
        ContextMenu.Close();
        var title = review switch
        {
            PortalFlightWorkDialog.ApprovalAction.Approve => $"Approve cancellation order · {Flight.FlightNumber}",
            PortalFlightWorkDialog.ApprovalAction.Unlock => $"Unlock cancellation order · {Flight.FlightNumber}",
            _ => viewReports ? $"Cancellation order · {Flight.FlightNumber}" : "Cancel flight"
        };
        var result = await Dialogs.OpenAsync<PortalFlightCancellationDialog>(
            title,
            new()
            {
                [nameof(PortalFlightCancellationDialog.FlightId)] = Flight.Id,
                [nameof(PortalFlightCancellationDialog.ViewOrder)] = viewReports,
                [nameof(PortalFlightCancellationDialog.ViewOnly)] = ViewOnly,
                [nameof(PortalFlightCancellationDialog.AdministratorEntry)] = CanOperateAsAdministrator,
                [nameof(PortalFlightCancellationDialog.ReviewAction)] = review
            },
            new DialogOptions { Width = "760px", CloseDialogOnOverlayClick = false, CloseDialogOnEsc = false, ShowClose = false });
        if (result is true)
            await Changed.InvokeAsync();
    }
}

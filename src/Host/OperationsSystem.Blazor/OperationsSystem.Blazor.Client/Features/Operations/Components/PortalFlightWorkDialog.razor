@implements IAsyncDisposable

<div class="portal-operations-editor">
    @if (loading)
    {
        <LoadingCard />
    }
    else if (flight is null)
    {
        <ErrorState Message="@(error ?? "Could not load the flight work.")" OnRetry="@LoadAsync" />
    }
    else
    {
        <div class="portal-editor-body" @ref="validationContainer">
            <ol class="portal-stepper" aria-label="Flight operation steps">
                @for (var i = 0; i < StepLabels.Length; i++)
                {
                    var index = i;
                    <li class="@StepClass(index)">
                        <button type="button" aria-current="@(index == step ? "step" : null)"
                                title="@StepLabels[index]"
                                disabled="@(saving || IsGuidedEntry && index > step)" @onclick="@(() => ChangeStep(index))">
                            <span class="portal-step-number">
                                @if (IsCompletedStep(index))
                                {
                                    <RadzenIcon Icon="check" />
                                }
                                else
                                {
                                    @(index + 1)
                                }
                            </span>
                            <span class="portal-step-label">@StepLabels[index]</span>
                        </button>
                    </li>
                }
            </ol>
            <div @key="step" class="portal-editor-content" role="region" aria-label="@StepLabels[step]" tabindex="0">
                @if (lookups.HasUnavailableCatalogs)
                {
                    <DismissibleDialogMessage AlertStyle="AlertStyle.Warning" StateKey="@("flight-work-catalogs")">
                        Some reference choices are unavailable with your current permissions.
                    </DismissibleDialogMessage>
                }
                @switch (step)
                {
                    case 0:
                        <section class="portal-editor-section">
                            <h3>Arrival</h3>
                            @if (flight.ArrivalSubmissions.Count > 1)
                            {
                                <label class="portal-report-picker">
                                    <span>Arrival report</span>
                                    <RadzenDropDown TValue="Guid?" Data="@ArrivalOptions()" TextProperty="@nameof(PortalCatalogChoice.Label)"
                                                    ValueProperty="@nameof(PortalCatalogChoice.Id)" Value="@arrivalSource?.Id"
                                                    ValueChanged="@SelectArrivalAsync" Disabled="@saving" />
                                </label>
                            }
                            @if (arrivalSource is { } submittedArrival)
                            {
                                <p class="portal-work-note">Received by @submittedArrival.ReceivedByEmployee.FullName · Reported by @submittedArrival.SubmittedByEmployee.FullName</p>
                            }
                            @if (arrivalSource is not null || flight.CanSaveArrival)
                            {
                                <div class="portal-editor-grid">
                                    <PortalOperationDateField Label="Actual time of arrival" Time="@arrivalTime" Required="true"
                                                              Disabled="@(!CanEditArrival || saving)" Validation="@validation" ValidationField="@ArrivalTimeField"
                                                              Changed="@RefreshValidation" />
                                    <label>
                                        <span>Aircraft type *</span>
                                        <RadzenDropDown TValue="Guid?" Data="@PortalWorkLookups.WithSaved(lookups.Aircraft, arrivalSource?.AircraftTypeId ?? flight.AircraftTypeId, arrivalSource?.AircraftTypeModel ?? flight.AircraftTypeModel)"
                                                        TextProperty="@nameof(PortalCatalogChoice.Label)" ValueProperty="@nameof(PortalCatalogChoice.Id)"
                                                        @bind-Value="aircraftTypeId" @bind-Value:after="RefreshValidation"
                                                        AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                        Disabled="@(!CanEditArrival || saving)" aria-invalid="@validation.InvalidAttribute(AircraftField)"
                                                        aria-describedby="@validation.DescriptionId(AircraftField)" />
                                        <PortalFieldError Validation="@validation" Field="@AircraftField" />
                                    </label>
                                    <label>
                                        <span>Tail number *</span>
                                        <RadzenTextBox @bind-Value="tailNumber" @bind-Value:after="RefreshValidation" Immediate="true" Disabled="@(!CanEditArrival || saving)"
                                                       aria-invalid="@validation.InvalidAttribute(TailField)" aria-describedby="@validation.DescriptionId(TailField)" />
                                        <PortalFieldError Validation="@validation" Field="@TailField" />
                                    </label>
                                    <label>
                                        <span>Customer work reference</span>
                                        <RadzenTextBox @bind-Value="arrivalReference" @bind-Value:after="RefreshValidation" Immediate="true" Disabled="@(!CanEditArrival || saving)" />
                                    </label>
                                    <label class="portal-editor-full">
                                        <span>Arrival remarks @if (RequiresArrivalRemarks) { <span aria-hidden="true">*</span> }</span>
                                        <RadzenTextArea @bind-Value="arrivalRemarks" @bind-Value:after="RefreshValidation" Immediate="true" Rows="3" Disabled="@(!CanEditArrival || saving)"
                                                        aria-invalid="@validation.InvalidAttribute(ArrivalRemarksField)" aria-describedby="@validation.DescriptionId(ArrivalRemarksField)" />
                                        <PortalFieldError Validation="@validation" Field="@ArrivalRemarksField" />
                                    </label>
                                </div>
                            }
                            else
                            {
                                <p class="portal-work-note">No arrival reported.</p>
                            }
                        </section>
                        break;
                    case 1:
                        <PortalWorkRecordsEditor FlightId="@flight.Id" Records="@services" Zone="@zone" Lookups="@lookups"
                                                 CanAdd="@(flight.CanAddServices ?? flight.CanSaveServices)" ReadOnly="@(ViewOnly || saving)"
                                                 Validation="@validation" ValidationAttempt="@validationFocusAttempt" Changed="@RefreshValidation" />
                        break;
                    case 2:
                        <PortalWorkRecordsEditor FlightId="@flight.Id" Records="@tasks" Zone="@zone" Lookups="@lookups" IsTask="true"
                                                 CanAdd="@(flight.CanAddTasks ?? flight.CanSaveTasks)" ReadOnly="@(ViewOnly || saving)"
                                                 Validation="@validation" ValidationAttempt="@validationFocusAttempt" Changed="@RefreshValidation" />
                        break;
                    case 3:
                        <section class="portal-editor-section">
                            <h3>Departure</h3>
                            @if (flight.DepartureSubmissions.Count > 1)
                            {
                                <label class="portal-report-picker">
                                    <span>Departure report</span>
                                    <RadzenDropDown TValue="Guid?" Data="@DepartureOptions()" TextProperty="@nameof(PortalCatalogChoice.Label)"
                                                    ValueProperty="@nameof(PortalCatalogChoice.Id)" Value="@departureSource?.Id"
                                                    ValueChanged="@SelectDepartureAsync" Disabled="@saving" />
                                </label>
                            }
                            @if (departureSource is { } submittedDeparture)
                            {
                                <p class="portal-work-note">Handled by @submittedDeparture.HandledByEmployee.FullName · Reported by @submittedDeparture.SubmittedByEmployee.FullName</p>
                            }
                            @if (departureSource is not null || flight.CanSaveDeparture)
                            {
                                <div class="portal-editor-grid">
                                    <PortalOperationDateField Label="Actual time of departure" Time="@departureTime" Required="true"
                                                              Disabled="@(!CanEditDeparture || saving)" Validation="@validation" ValidationField="@DepartureTimeField"
                                                              Changed="@RefreshValidation" />
                                    <label class="portal-editor-full">
                                        <span>Departure remarks</span>
                                        <RadzenTextArea @bind-Value="departureRemarks" @bind-Value:after="RefreshValidation" Immediate="true" Rows="3" Disabled="@(!CanEditDeparture || saving)" />
                                    </label>
                                </div>
                                <PortalWorkSignature @key="signature" FlightId="@flight.Id" Draft="@signature" Zone="@zone" Disabled="@(!CanEditDeparture || saving)"
                                                     Validation="@validation" ValidationField="@SignatureTimeField" Changed="@RefreshValidation" />
                            }
                            else
                            {
                                <p class="portal-work-note">No departure reported.</p>
                            }
                        </section>
                        break;
                    case 4:
                        <section class="portal-editor-section">
                            <div class="portal-editor-heading">
                                <h3>Returns to ramp</h3>
                                @if (!ViewOnly && flight.CanSaveReturnsToRamp && flight.DepartureSubmissions.Count > 0 && flight.ReturnToRamps.All(item => !item.IsOpen))
                                {
                                    <RadzenButton Text="Add RTR" Icon="add" ButtonStyle="ButtonStyle.Light" Disabled="@saving"
                                                  Click="@(() => OpenReturnToRampAsync(null))" />
                                }
                            </div>
                            @if (flight.ReturnToRamps.Count == 0)
                            {
                                <p class="portal-work-note">@(flight.DepartureSubmissions.Count == 0 ? "Record a departure before adding a return to ramp." : "No returns to ramp recorded.")</p>
                            }
                            @foreach (var occurrence in flight.ReturnToRamps)
                            {
                                <div class="portal-occurrence" @key="occurrence.Id">
                                    <div>
                                        <strong>RTR @occurrence.Sequence</strong>
                                        <p class="portal-work-note">@zone.Format(occurrence.ArrivedAtUtc) – @(occurrence.DepartedAtUtc is { } departure ? zone.Format(departure) : "Open")</p>
                                    </div>
                                    <RadzenButton Text="@(!ViewOnly && occurrence.CanEdit ? "Edit" : "View")" Icon="@(!ViewOnly && occurrence.CanEdit ? "edit" : "visibility")"
                                                  ButtonStyle="ButtonStyle.Light" Disabled="@saving" Click="@(() => OpenReturnToRampAsync(occurrence.Id))" />
                                </div>
                            }
                        </section>
                        break;
                }

            </div>
        </div>
        <PortalValidationFocus Container="@validationContainer" Attempt="@validationFocusAttempt" />
    }

    <footer class="portal-editor-footer">
        @if (!loading && flight is not null)
        {
            <PortalFlightValidationSummary Validation="@validation" Attempt="@validationFocusAttempt" />
            @if (error is not null)
            {
                <DismissibleDialogMessage AlertStyle="AlertStyle.Danger" StateKey="@error" OnDismiss="@(() => error = null)">
                    @error
                </DismissibleDialogMessage>
            }
            <div class="portal-editor-actions">
                @if (IsGuidedEntry && step > 0)
                {
                    <RadzenButton Text="Previous" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Disabled="@saving"
                                  class="portal-editor-previous" Click="@(() => ChangeStep(step - 1))" />
                }
                <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Light" Disabled="@saving" Click="@CloseAsync" />
                @if (IsGuidedEntry && step + 1 < StepLabels.Length)
                {
                    <RadzenButton Text="Next" Icon="arrow_forward" ButtonStyle="ButtonStyle.Light" Disabled="@saving" Click="@NextStep" />
                }
                @if (CanEditNormalWork)
                {
                    <RadzenButton Text="Save" BusyText="Saving…" IsBusy="@saving" Icon="check" ButtonStyle="ButtonStyle.Primary"
                                  Click="@SaveAsync" />
                }
            </div>
        }
        else
        {
            <div class="portal-editor-actions">
                <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Light" Click="@CloseWithoutSaving" />
            </div>
        }
    </footer>
</div>

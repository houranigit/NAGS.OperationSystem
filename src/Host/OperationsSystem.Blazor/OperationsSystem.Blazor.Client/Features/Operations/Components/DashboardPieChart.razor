<article class="@CardClass">
    <header class="dpc-header">
        <div class="dpc-title">
            <span class="dpc-icon" aria-hidden="true">
                <RadzenIcon Icon="@icon" />
            </span>
            <div>
                <h3>@title</h3>
                <p>@description</p>
            </div>
        </div>
        @if (hasData)
        {
            <div class="dpc-total">
                <strong>@FormatCount(total)</strong>
                <span>@totalLabel</span>
            </div>
        }
    </header>

    @if (!hasData)
    {
        <div class="dpc-empty">
            <span><RadzenIcon Icon="@icon" /></span>
            <p>@emptyText</p>
        </div>
    }
    else
    {
        <div class="dpc-chart" role="img" aria-label="@ChartAriaLabel">
            <RadzenChart Width="100%"
                         Height="278px"
                         Animate="true"
                         AnimateDataUpdates="true"
                         AnimationDuration="360"
                         MarginTop="20"
                         MarginBottom="22"
                         MarginLeft="44"
                         MarginRight="44">
                <RadzenPieSeries TItem="PieEntry"
                                 Data="@entries"
                                 CategoryProperty="@nameof(PieEntry.LegendLabel)"
                                 ValueProperty="@nameof(PieEntry.FlightCount)"
                                 Fills="@fills"
                                 StrokeWidth="0"
                                 CornerRadius="4"
                                 SegmentGap="2"
                                 ExplodeOffset="3"
                                 StartAngle="270"
                                 TotalAngle="360"
                                 FillMode="FillMode.Gradient"
                                 ShowTooltipOnLegend="true">
                    <ChildContent>
                        <RadzenSeriesDataLabels Visible="true"
                                                Position="DataLabelPosition.Auto"
                                                Appearance="DataLabelAppearance.Outline"
                                                AllowOverlap="false"
                                                Formatter="@FormatChartLabel" />
                    </ChildContent>
                    <TooltipTemplate Context="entry">
                        <div class="dpc-tooltip">
                            <strong>@entry.Label</strong>
                            <span>@FormatCount(entry.FlightCount) @flightsLabel</span>
                            <span>@FormatPercentage(entry.Percentage)</span>
                        </div>
                    </TooltipTemplate>
                </RadzenPieSeries>
                <RadzenChartTooltipOptions Visible="true" HighlightDataPoint="true" />
                <RadzenLegend Visible="true" Position="LegendPosition.Bottom" />
            </RadzenChart>
        </div>
    }
</article>

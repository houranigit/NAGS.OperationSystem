<article class="@CardClass">
    <header class="dpc-header">
        <div class="dpc-title">
            <span class="dpc-icon" aria-hidden="true">
                <RadzenIcon Icon="@icon" />
            </span>
            <div>
                <h3>@title</h3>
                <p>@description</p>
            </div>
        </div>
        @if (hasData)
        {
            <div class="dpc-total">
                <strong>@FormatCount(total)</strong>
                <span>@totalLabel</span>
            </div>
        }
    </header>

    @if (!hasData)
    {
        <div class="dpc-empty">
            <span><RadzenIcon Icon="@icon" /></span>
            <p>@emptyText</p>
        </div>
    }
    else
    {
        <div class="dpc-chart">
            <div class="dpc-plot" role="img" aria-label="@ChartAriaLabel">
                <RadzenChart Animate="true"
                             AnimateDataUpdates="true"
                             AnimationDuration="360">
                    <RadzenPieSeries TItem="PieEntry"
                                     Data="@entries"
                                     CategoryProperty="@nameof(PieEntry.Label)"
                                     ValueProperty="@nameof(PieEntry.FlightCount)"
                                     Fills="@fills"
                                     StrokeWidth="0"
                                     CornerRadius="4"
                                     SegmentGap="2"
                                     ExplodeOffset="3"
                                     StartAngle="270"
                                     TotalAngle="360"
                                     FillMode="FillMode.Gradient">
                        <ChildContent>
                            <RadzenSeriesDataLabels Visible="true"
                                                    Position="DataLabelPosition.Auto"
                                                    Appearance="DataLabelAppearance.Chip"
                                                    AllowOverlap="false"
                                                    Formatter="@FormatChartLabel" />
                        </ChildContent>
                        <TooltipTemplate Context="entry">
                            <div class="dpc-tooltip">
                                <strong>@entry.Label</strong>
                                <span>@FormatCount(entry.FlightCount) @flightsLabel</span>
                                <span>@FormatPercentage(entry.Percentage)</span>
                            </div>
                        </TooltipTemplate>
                    </RadzenPieSeries>
                    <RadzenChartTooltipOptions Visible="true" HighlightDataPoint="true" />
                    <RadzenLegend Visible="false" />
                </RadzenChart>
            </div>

            <ul class="dpc-legend" aria-label="@title">
                @for (var index = 0; index < entries.Count; index++)
                {
                    var entry = entries[index];
                    <li @key="entry.Key"
                        title="@LegendItemDescription(entry)"
                        aria-label="@LegendItemDescription(entry)">
                        <svg class="dpc-legend-swatch"
                             viewBox="0 0 10 10"
                             aria-hidden="true"
                             focusable="false">
                            <circle cx="5" cy="5" r="5" fill="@LegendSwatchFill(index)" />
                        </svg>
                        <span>@entry.Label</span>
                    </li>
                }
            </ul>
        </div>
    }
</article>

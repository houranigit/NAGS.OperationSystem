@inject OperationsApiClient Operations
@inject AuthSession Auth
@inject DialogService Dialogs
@inject NotificationService Notifications

<div class="pcf-dialog">
    @if (isLoading)
    {
        <div role="status">Loading flight…</div>
    }
    else if (flight is { } currentFlight && canceledAt is { } time)
    {
        <PortalFlightSummary Flight="@currentFlight" StatusLabel="@(submission is null ? null : "Cancellation submitted")" StatusTone="danger" />
        @if (currentFlight.WorkOrderNumber is { } workOrderNumber)
        {
            <div>WO# <strong>@workOrderNumber</strong></div>
        }
        <section aria-labelledby="portal-cancellation-heading" class="pcf-fields">
            <h3 id="portal-cancellation-heading" class="pcf-heading">
                <RadzenIcon Icon="event_busy" /> Cancellation
            </h3>
            @if (reports.Count > 1)
            {
                <div class="pcf-date">
                    <PortalOperationFormField Label="Cancellation report">
                        <RadzenDropDown TValue="Guid?" Data="@ReportOptions()" TextProperty="@nameof(PortalCatalogChoice.Label)"
                                        ValueProperty="@nameof(PortalCatalogChoice.Id)" Value="@submission?.Id"
                                        ValueChanged="@SelectReportAsync" Disabled="@isSaving" class="pcf-control" />
                    </PortalOperationFormField>
                </div>
            }
            @if (submission is { } report)
            {
                <div>Submitted by <strong>@report.SubmitterName</strong></div>
            }
            <div class="pcf-date">
                <PortalOperationDateField Label="@($"Cancellation date and time ({currentFlight.StationTimeZoneId})")"
                                          Time="@time" Required="@CanSave" Disabled="@(!CanSave || isSaving)" />
            </div>
            <div>
                <RadzenLabel Component="portalCancellationRemarks" Text="@(CanSave ? "Remarks (optional)" : "Remarks")" />
                <RadzenTextArea Name="portalCancellationRemarks" @bind-Value="remarks" Immediate="true" Rows="4"
                                Disabled="@(!CanSave || isSaving)" class="pcf-control" />
            </div>
        </section>
    }

    @if (errorMessage is not null)
    {
        <DismissibleDialogMessage AlertStyle="AlertStyle.Danger" StateKey="@errorMessage" OnDismiss="@(() => errorMessage = null)">
            @errorMessage
        </DismissibleDialogMessage>
    }

    <div class="pcf-actions">
        <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Light" Disabled="@isSaving"
                      Click="@(() => Dialogs.Close(false))" />
        <div class="pcf-actions-end">
            @if (IsApprovalReview && flight is not null)
            {
                <RadzenButton Text="@(IsUnlockReview ? "Unlock" : "Approve")"
                              BusyText="@(IsUnlockReview ? "Unlocking…" : "Approving…")"
                              Icon="@(IsUnlockReview ? "lock_open" : "verified")"
                              ButtonStyle="ButtonStyle.Primary" Disabled="@(!CanChangeApproval || isSaving)"
                              IsBusy="@isSaving" Click="@ChangeApprovalAsync" />
            }
            @if (CanUndo)
            {
                <RadzenButton Text="Undo" Icon="undo" ButtonStyle="ButtonStyle.Danger" Disabled="@isSaving" Click="@UndoAsync" />
            }
            @if (CanSave)
            {
                <RadzenButton Text="@(submission is null ? "Submit cancellation" : "Save")"
                              ButtonStyle="ButtonStyle.Primary" IsBusy="@isSaving" Click="@SaveAsync" />
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Guid FlightId { get; set; }
    [Parameter] public bool ViewOnly { get; set; }
    [Parameter] public bool AdministratorEntry { get; set; }
    [Parameter] public bool ViewOrder { get; set; }
    [Parameter] public PortalFlightWorkDialog.ApprovalAction ReviewAction { get; set; }

    private PortalFlightOperations? flight;
    private PortalFlightCancellation? submission;
    private IReadOnlyList<PortalFlightCancellation> reports = [];
    private StationTimeZone zone = default!;
    private PortalOperationTime? canceledAt;
    private string? remarks;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSaving;

    private bool IsApprovalReview => ReviewAction != PortalFlightWorkDialog.ApprovalAction.None;
    private bool IsUnlockReview => ReviewAction == PortalFlightWorkDialog.ApprovalAction.Unlock;
    private bool CanChangeApproval => ReviewAction switch
    {
        PortalFlightWorkDialog.ApprovalAction.Approve => flight?.CanApprove == true,
        PortalFlightWorkDialog.ApprovalAction.Unlock => flight?.CanUnlock == true,
        _ => false
    };
    private bool CanSave => !IsApprovalReview && !ViewOnly &&
        flight is { IsApprovalLocked: false, CanSaveCancellation: true } details &&
        (submission is null || AdministratorEntry || OwnsSubmission(details, submission));
    private bool CanUndo => !IsApprovalReview && !ViewOnly && flight is { IsApprovalLocked: false } details &&
        submission is { } report && OwnsSubmission(details, report);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var details = await Operations.GetPortalFlightOperationsAsync(FlightId);
            var viewingOrder = IsApprovalReview || ViewOrder;
            if (viewingOrder)
            {
                reports = Auth.IsSystemAdministrator || details.CanApprove || details.CanUnlock
                    ? details.CancellationSubmissions
                    : details.CancellationSubmissions.Where(item => OwnsSubmission(details, item)).ToArray();
            }

            if (viewingOrder ? reports.Count == 0 || IsApprovalReview && details.HasWorkOrderRecords
                : ViewOnly || details.IsApprovalLocked || !details.CanSaveCancellation || details.HasOperationalRecords)
            {
                errorMessage = "Flight actions have changed. Close this dialog and open the actions menu again.";
                return;
            }

            zone = StationTimeZone.FromId(details.StationTimeZoneId);
            SetReport(reports.FirstOrDefault(item => OwnsSubmission(details, item)) ?? reports.FirstOrDefault());
            flight = details;

            if (IsApprovalReview && !CanChangeApproval)
                errorMessage = "This approval action is no longer available. Reopen the Cancellation Order menu.";
        }
        catch (ApiException ex)
        {
            errorMessage = ex.ToDisplayMessage("Could not load the cancellation.");
        }
        catch (JSException)
        {
            errorMessage = "Could not reach the server. Close this dialog and try again.";
        }
        catch (TimeZoneNotFoundException)
        {
            errorMessage = "The station time zone is unavailable.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool OwnsSubmission(PortalFlightOperations details, PortalFlightCancellation report) =>
        report.IsAccountSubmissionBy(Auth.User?.Id) ||
        details.CurrentStaffMemberId is { } staffId && report.SubmittedByEmployee?.StaffMemberId == staffId;

    private IEnumerable<PortalCatalogChoice> ReportOptions() => reports.Select(
        report => new PortalCatalogChoice(report.Id, $"{report.SubmitterName} · {zone.Format(report.CanceledAtUtc)}"));

    private void SetReport(PortalFlightCancellation? report)
    {
        submission = report;
        canceledAt = new PortalOperationTime(zone, report?.CanceledAtUtc ?? DateTimeOffset.UtcNow);
        remarks = report?.Remarks;
    }

    private async Task SelectReportAsync(Guid? id)
    {
        if (isSaving || id == submission?.Id || reports.FirstOrDefault(item => item.Id == id) is not { } report)
            return;

        if (CanSave && (canceledAt?.HasChanged == true || remarks != submission?.Remarks) &&
            await Dialogs.Confirm("Discard the unsaved changes?", "Discard changes",
                new ConfirmOptions { OkButtonText = "Discard", CancelButtonText = "Keep editing" }) != true)
            return;

        SetReport(report);
        if (!IsApprovalReview)
            errorMessage = null;
    }

    private async Task ChangeApprovalAsync()
    {
        if (isSaving || !CanChangeApproval || flight is not { } details)
            return;

        isSaving = true;
        errorMessage = null;
        try
        {
            if (IsUnlockReview)
                await Operations.UnlockPortalFlightAsync(FlightId, details.RowVersion);
            else
                await Operations.ApprovePortalFlightAsync(FlightId, details.RowVersion);
            Dialogs.Close(true);
        }
        catch (ApiException ex)
        {
            errorMessage = ex.ToDisplayMessage(IsUnlockReview ? "Could not unlock the flight." : "Could not approve the flight.");
        }
        catch (JSException)
        {
            errorMessage = "The approval change could not be confirmed. Reopen the flight to check its status.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveAsync()
    {
        if (!CanSave || isSaving || flight is not { } details || canceledAt is null)
            return;

        errorMessage = null;
        var errors = new List<string>();
        if (canceledAt.Read("Cancellation date and time", errors, required: true) is not { } utc)
        {
            errorMessage = errors.FirstOrDefault() ?? "Enter the cancellation date and time.";
            return;
        }

        isSaving = true;
        try
        {
            var hasOpposingReports = details.ArrivalSubmissions.Count > 0 || details.DepartureSubmissions.Count > 0;
            if (hasOpposingReports && await Dialogs.Confirm(
                AdministratorEntry && submission is not null
                    ? "Arrival or departure has been reported for this flight. Save the correction to this cancellation?"
                    : "Arrival or departure has been reported for this flight. Submit your cancellation as a separate report?",
                "Confirm cancellation report", new ConfirmOptions { OkButtonText = "Continue", CancelButtonText = "Back" }) != true)
                return;

            var request = new PortalFlightCancellationRequest(utc, remarks, hasOpposingReports);
            if (AdministratorEntry && submission is { } report)
                await Operations.UpdatePortalCancellationAsync(FlightId, report.Id, request, details.RowVersion);
            else
                await Operations.SavePortalCancellationAsync(FlightId, request, details.RowVersion);
            Notifications.Notify(NotificationSeverity.Success, "Cancellation saved");
            Dialogs.Close(true);
        }
        catch (ApiException ex)
        {
            errorMessage = ex.ToDisplayMessage("Could not save the cancellation.");
        }
        catch (JSException)
        {
            errorMessage = "Could not confirm that the cancellation was saved. Try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task UndoAsync()
    {
        if (!CanUndo || isSaving || flight is null || submission is null)
            return;

        isSaving = true;
        errorMessage = null;
        try
        {
            if (!await ConfirmUndoAsync(Dialogs))
                return;

            await Operations.UndoPortalCancellationAsync(FlightId, submission.Id, flight.RowVersion);
            Notifications.Notify(NotificationSeverity.Success, "Cancellation undone");
            Dialogs.Close(true);
        }
        catch (ApiException ex)
        {
            errorMessage = ex.ToDisplayMessage("Could not undo the cancellation.");
        }
        catch (JSException)
        {
            errorMessage = "Could not confirm that the cancellation was undone. Try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    internal static async Task<bool> ConfirmUndoAsync(DialogService dialogs) =>
        await dialogs.Confirm("Remove your cancellation submission for this flight?", "Undo cancellation",
            new ConfirmOptions { OkButtonText = "Undo", CancelButtonText = "Keep cancellation" }) == true;
}

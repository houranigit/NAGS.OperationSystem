    private RenderFragment Actions() => @<div class="owf-actions">
        <div>
            @if (step > 0)
            {
                <RadzenButton Text="Previous" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" ButtonType="ButtonType.Button" Click="@Previous" />
            }
            else
            {
                <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Light" ButtonType="ButtonType.Button" Click="@(() => DialogService.Close(false))" />
            }
        </div>
        <div class="owf-actions-end">
            @if (step > 0)
            {
                <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Light" ButtonType="ButtonType.Button" Click="@(() => DialogService.Close(false))" />
            }
            @if (step < LastStep)
            {
                <RadzenButton Text="Next" Icon="arrow_forward" ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Button" Click="@NextAsync" />
            }
            else
            {
                <RadzenButton Text="Create" Icon="check" ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Button"
                              Disabled="@isSubmitting" Click="@SubmitAsync" />
            }
        </div>
    </div>;

    private void SetType(string type)
    {
        model.Type = type;
        if (step > LastStep)
            step = LastStep;
        validationMessages = [];
        errorMessage = null;
    }

    private void MoveToStep(int index)
    {
        if (index <= step && index <= LastStep)
        {
            step = index;
            validationMessages = [];
            errorMessage = null;
        }
    }

    private async Task NextAsync()
    {
        var validation = ValidateCurrentStep();
        if (validation.Count > 0)
        {
            validationMessages = validation;
            errorMessage = null;
            return;
        }

        if (step == 0)
            await LoadStaffForStationAsync();
        if (errorMessage is not null)
            return;

        validationMessages = [];
        errorMessage = null;
        step = Math.Min(LastStep, step + 1);
    }

    private void Previous()
    {
        validationMessages = [];
        errorMessage = null;
        step = Math.Max(0, step - 1);
    }

    private async Task SubmitAsync()
    {
        var validation = ValidateAll();
        if (validation.Count > 0)
        {
            validationMessages = validation;
            errorMessage = null;
            return;
        }

        isSubmitting = true;
        validationMessages = [];
        errorMessage = null;
        try
        {
            var request = new CreateAdHocWorkOrderRequestModel(
                model.CustomerId!.Value,
                model.StationId!.Value,
                model.FlightNumber.Trim(),
                ToOffset(model.ScheduledArrivalUtc)!.Value,
                ToOffset(model.ScheduledDepartureUtc)!.Value,
                model.AircraftTypeId,
                [],
                [],
                BuildWorkOrderRequest());

            var workOrderId = await Operations.CreateAdHocWorkOrderAsync(request);
            DialogService.Close(workOrderId);
        }
        catch (ApiException ex)
        {
            errorMessage = ex.ToDisplayMessage("Could not create the work order.");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private WorkOrderRequestModel BuildWorkOrderRequest()
    {
        var completion = IsCompletion;
        return new WorkOrderRequestModel(
            model.Type,
            completion ? model.FlightNumber : null,
            completion ? model.AircraftTypeId : null,
            completion ? model.AircraftTailNumber : null,
            completion ? ToOffset(model.ActualArrivalUtc) : null,
            completion ? ToOffset(model.ActualDepartureUtc) : null,
            IsCancellation ? ToOffset(model.CanceledAtUtc) : null,
            IsCancellation ? model.CancellationReason : null,
            completion ? model.Remarks : null,
            completion
                ? model.ServiceLines.Select(l => new WorkOrderServiceLineRequestModel(
                    l.ServiceId!.Value,
                    l.PerformedByStaffMemberIds.ToList(),
                    ToOffset(l.FromUtc)!.Value,
                    ToOffset(l.ToUtc)!.Value,
                    l.Description,
                    Attachments: l.Attachments.Select(a => new WorkOrderServiceLineAttachmentRequestModel(
                        a.Kind,
                        Convert.ToBase64String(a.Content),
                        a.OriginalFileName,
                        a.ContentType)).ToList())).ToList()
                : [],
            completion
                ? model.Tasks.Select(t => new WorkOrderTaskRequestModel(
                    null,
                    t.TaskType,
                    t.Description,
                    ToOffset(t.FromUtc)!.Value,
                    ToOffset(t.ToUtc)!.Value,
                    t.EmployeeIds.ToList(),
                    t.Tools.Select(r => new WorkOrderTaskToolRequestModel(
                        r.ItemId!.Value,
                        CalculationTypeFor(r, toolOptions) == ResourceCalculationType.Quantity ? r.Quantity : null,
                        CalculationTypeFor(r, toolOptions) == ResourceCalculationType.Duration ? ToOffset(r.FromUtc) : null,
                        CalculationTypeFor(r, toolOptions) == ResourceCalculationType.Duration ? ToOffset(r.ToUtc) : null)).ToList(),
                    t.Materials.Select(r => new WorkOrderTaskMaterialRequestModel(
                        r.ItemId!.Value,
                        CalculationTypeFor(r, materialOptions) == ResourceCalculationType.Quantity ? r.Quantity : null,
                        CalculationTypeFor(r, materialOptions) == ResourceCalculationType.Duration ? ToOffset(r.FromUtc) : null,
                        CalculationTypeFor(r, materialOptions) == ResourceCalculationType.Duration ? ToOffset(r.ToUtc) : null)).ToList(),
                    t.GeneralSupports.Select(r => new WorkOrderTaskGeneralSupportRequestModel(
                        r.ItemId!.Value,
                        CalculationTypeFor(r, supportOptions) == ResourceCalculationType.Quantity ? r.Quantity : null,
                        CalculationTypeFor(r, supportOptions) == ResourceCalculationType.Duration ? ToOffset(r.FromUtc) : null,
                        CalculationTypeFor(r, supportOptions) == ResourceCalculationType.Duration ? ToOffset(r.ToUtc) : null)).ToList(),
                    t.Attachments.Select(a => new WorkOrderTaskAttachmentRequestModel(
                        a.Kind,
                        Convert.ToBase64String(a.Content),
                        a.OriginalFileName,
                        a.ContentType)).ToList())).ToList()
                : [],
            !completion || model.CustomerSignature is null
                ? null
                : new WorkOrderSignatureRequestModel(
                    Convert.ToBase64String(model.CustomerSignature.Content),
                    model.CustomerSignature.FileName,
                    model.CustomerSignature.ContentType),
            completion ? ReturnToRampDraftMapper.ToRequests(model.ReturnToRamps, UserTimeZone) : null);
    }

    private List<string> ValidateAll()
    {
        var messages = new List<string>();
        for (var i = 0; i <= LastStep; i++)
            messages.AddRange(ValidateStep(i));
        AddTimeZoneValidation(messages);
        return messages.Distinct().ToList();
    }

    private void AddTimeZoneValidation(List<string> messages)
    {
        var values = new List<DateTime?>
        {
            model.ScheduledArrivalUtc,
            model.ScheduledDepartureUtc,
            model.ActualArrivalUtc,
            model.ActualDepartureUtc,
            model.CanceledAtUtc
        };
        values.AddRange(model.ServiceLines.SelectMany(line => new[] { line.FromUtc, line.ToUtc }));
        values.AddRange(model.Tasks.SelectMany(task => new[] { task.FromUtc, task.ToUtc }));
        values.AddRange(model.Tasks.SelectMany(task => task.Tools
            .Concat(task.Materials)
            .Concat(task.GeneralSupports)
            .SelectMany(resource => new[] { resource.FromUtc, resource.ToUtc })));

        foreach (var value in values.Where(value => value.HasValue))
        {
            if (!UserTimeZone.TryToUtc(value, out _, out var error) && error is not null)
                messages.Add(error);
        }
    }

    private List<string> ValidateCurrentStep() => ValidateStep(step);

    private List<string> ValidateStep(int index) => index switch
    {
        CompletionWorkOrderWizard.DetailsStep => ValidateFlight(),
        CompletionWorkOrderWizard.ServiceLinesStep => ValidateServiceLines(),
        CompletionWorkOrderWizard.TasksStep => ValidateTasks(),
        CompletionWorkOrderWizard.ReturnToRampsStep => ValidateReturnToRamps(),
        _ => []
    };

    private List<string> ValidateReturnToRamps()
    {
        var messages = new List<string>();
        foreach (var (occurrence, index) in model.ReturnToRamps.Select((item, index) => (item, index + 1)))
            messages.AddRange(ReturnToRampDraftValidation.Validate(occurrence, UserTimeZone, $"Return to ramp {index}"));
        return messages.Distinct().ToList();
    }

    private List<string> ValidateFlight()
    {
        var messages = new List<string>();
        if (model.CustomerId is null)
            messages.Add("Customer is required.");
        if (model.StationId is null)
            messages.Add("Station is required.");
        if (string.IsNullOrWhiteSpace(model.FlightNumber))
            messages.Add("Flight number is required.");
        else if (model.FlightNumber.Trim().Length > 12)
            messages.Add("Flight number must be at most 12 characters.");
        if (IsMissing(model.ScheduledArrivalUtc))
            messages.Add("Scheduled arrival is required.");
        if (IsMissing(model.ScheduledDepartureUtc))
            messages.Add("Scheduled departure is required.");
        if (!IsMissing(model.ScheduledArrivalUtc) && !IsMissing(model.ScheduledDepartureUtc) && model.ScheduledDepartureUtc!.Value <= model.ScheduledArrivalUtc!.Value)
            messages.Add("Scheduled departure must be after scheduled arrival.");
        if (IsCancellation)
        {
            if (IsMissing(model.CanceledAtUtc))
                messages.Add("Cancellation date/time is required.");
            if (string.IsNullOrWhiteSpace(model.CancellationReason))
                messages.Add("Cancellation reason is required.");
            return messages;
        }

        if (model.AircraftTypeId is null)
            messages.Add("Aircraft type is required.");
        if (!string.IsNullOrWhiteSpace(model.AircraftTailNumber) && model.AircraftTailNumber.Trim().Length > 20)
            messages.Add("Tail number must be at most 20 characters.");
        if (IsMissing(model.ActualArrivalUtc))
            messages.Add("ATA is required.");
        if (IsMissing(model.ActualDepartureUtc))
            messages.Add("ATD is required.");
        if (!IsMissing(model.ActualArrivalUtc) && !IsMissing(model.ActualDepartureUtc) && model.ActualDepartureUtc!.Value < model.ActualArrivalUtc!.Value)
            messages.Add("ATD cannot be before ATA.");
        return messages;
    }

    private List<string> ValidateServiceLines()
    {
        var messages = new List<string>();
        if (model.ServiceLines.Any(l => l.ServiceId is null || l.PerformedByStaffMemberIds is null || !l.PerformedByStaffMemberIds.Any() || IsMissing(l.FromUtc) || IsMissing(l.ToUtc)))
            messages.Add("Every service line needs a service, at least one performer, From, and To time.");
        if (model.ServiceLines.Any(l => !IsMissing(l.FromUtc) && !IsMissing(l.ToUtc) && l.ToUtc!.Value < l.FromUtc!.Value))
            messages.Add("Service line To time cannot be before From time.");
        if (model.ActualArrivalUtc is { } ata && model.ServiceLines.Any(l => !IsMissing(l.FromUtc) && l.FromUtc!.Value < ata))
            messages.Add("Service line From time cannot be before ATA.");
        if (model.ActualDepartureUtc is { } atd && model.ServiceLines.Any(l => !IsMissing(l.ToUtc) && l.ToUtc!.Value > atd))
            messages.Add("Service line To time cannot be after ATD.");
        return messages;
    }

    private List<string> ValidateTasks()
    {
        var messages = new List<string>();
        if (model.Tasks.Any(t => string.IsNullOrWhiteSpace(t.TaskType)))
            messages.Add("Every task needs a task type.");
        if (model.Tasks.Any(t => t.EmployeeIds is null || !t.EmployeeIds.Any()))
            messages.Add("Every task needs at least one employee.");
        if (model.Tasks.Any(t => IsMissing(t.FromUtc) || IsMissing(t.ToUtc)))
            messages.Add("Every task needs a From and To time.");
        if (model.Tasks.Any(t => !IsMissing(t.FromUtc) && !IsMissing(t.ToUtc) && t.ToUtc!.Value < t.FromUtc!.Value))
            messages.Add("Task To time cannot be before From time.");
        if (model.ActualArrivalUtc is { } ata && model.Tasks.Any(t => !IsMissing(t.FromUtc) && t.FromUtc!.Value < ata))
            messages.Add("Task From time cannot be before ATA.");
        if (model.ActualDepartureUtc is { } atd && model.Tasks.Any(t => !IsMissing(t.ToUtc) && t.ToUtc!.Value > atd))
            messages.Add("Task To time cannot be after ATD.");

        foreach (var (task, taskIndex) in model.Tasks.Select((value, index) => (value, index + 1)))
        {
            AddResourceValidation(messages, task, task.Tools, toolOptions, "tool", taskIndex);
            AddResourceValidation(messages, task, task.Materials, materialOptions, "material", taskIndex);
            AddResourceValidation(messages, task, task.GeneralSupports, supportOptions, "general support", taskIndex);
        }
        return messages;
    }

    private async Task CheckDuplicatesAsync()
    {
        var validation = ValidateDuplicateFields();
        if (validation.Count > 0)
        {
            validationMessages = validation;
            errorMessage = null;
            duplicateResultMessage = null;
            duplicates = [];
            return;
        }

        try
        {
            validationMessages = [];
            errorMessage = null;
            duplicateResultMessage = null;
            duplicates = [];

            var duplicateCandidates = await Operations.GetDuplicateCandidatesAsync(
                model.CustomerId!.Value,
                ToOffset(model.ScheduledArrivalUtc)!.Value,
                ToOffset(model.ScheduledDepartureUtc)!.Value,
                model.StationId);
            duplicates = duplicateCandidates;
            if (duplicates.Count == 0)
                duplicateResultMessage = "No duplicate flights found.";
        }
        catch (ApiException ex)
        {
            duplicateResultMessage = null;
            duplicates = [];
            errorMessage = ex.ToDisplayMessage("Could not check duplicate candidates.");
        }
    }

    private List<string> ValidateDuplicateFields()
    {
        var messages = new List<string>();
        if (model.CustomerId is null)
            messages.Add("Customer is required.");
        if (model.StationId is null)
            messages.Add("Station is required.");
        if (IsMissing(model.ScheduledArrivalUtc))
            messages.Add("Scheduled arrival is required.");
        if (IsMissing(model.ScheduledDepartureUtc))
            messages.Add("Scheduled departure is required.");
        if (!IsMissing(model.ScheduledArrivalUtc) && !IsMissing(model.ScheduledDepartureUtc) && model.ScheduledDepartureUtc!.Value <= model.ScheduledArrivalUtc!.Value)
            messages.Add("Scheduled departure must be after scheduled arrival.");
        return messages;
    }

    private async Task LoadStaffForStationAsync()
    {
        if (model.StationId is not { } stationId || staffLoadedForStationId == stationId)
            return;

        try
        {
            staffOptions = await MasterData.GetStaffMemberOptionsAsync(stationId);
            staffLoadedForStationId = stationId;
        }
        catch (ApiException ex)
        {
            errorMessage = ex.ToDisplayMessage("Could not load station staff.");
        }
    }

    private async Task OnStationChanged(object? value)
    {
        ClearDuplicateResult();
        staffLoadedForStationId = null;
        staffOptions = [];
        await LoadStaffForStationAsync();
    }

    private void OnCustomerChanged(object? value) => ClearDuplicateResult();

    private void OnScheduledArrivalChanged(DateTime? value)
    {
        ClearDuplicateResult();
        var previous = model.ScheduledArrivalUtc;
        model.ScheduledArrivalUtc = value;

        if (model.ActualArrivalUtc is null || model.ActualArrivalUtc == previous)
            model.ActualArrivalUtc = value;
        if (model.CanceledAtUtc is null || model.CanceledAtUtc == previous)
            model.CanceledAtUtc = value;
    }

    private void OnScheduledDepartureChanged(DateTime? value)
    {
        ClearDuplicateResult();
        var previous = model.ScheduledDepartureUtc;
        model.ScheduledDepartureUtc = value;

        if (model.ActualDepartureUtc is null || model.ActualDepartureUtc == previous)
            model.ActualDepartureUtc = value;
    }

    private void ClearDuplicateResult()
    {
        duplicateResultMessage = null;
        duplicates = [];
    }

    private void AddServiceLine() =>
        model.ServiceLines.Add(new ServiceLineForm { FromUtc = DefaultWindowStart, ToUtc = DefaultWindowEnd });

    private void RemoveServiceLine(ServiceLineForm line) => model.ServiceLines.Remove(line);

    private void AddTask() =>
        model.Tasks.Add(new TaskForm { FromUtc = DefaultWindowStart, ToUtc = DefaultWindowEnd });

    private void RemoveTask(TaskForm task) => model.Tasks.Remove(task);

    private Task AddReturnToRampAsync() => OpenReturnToRampEditorAsync(
        new ReturnToRampDraft { FromLocal = DefaultWindowStart, ToLocal = DefaultWindowEnd },
        isNew: true);

    private Task EditReturnToRampAsync(ReturnToRampDraft occurrence) =>
        OpenReturnToRampEditorAsync(occurrence, isNew: false);

    private async Task OpenReturnToRampEditorAsync(ReturnToRampDraft occurrence, bool isNew)
    {
        if (model.StationId is not { } stationId)
        {
            validationMessages = ["Select a station before adding a return to ramp."];
            return;
        }

        await LoadStaffForStationAsync();
        if (errorMessage is not null)
            return;

        var result = await DialogService.OpenAsync<ReturnToRampEditorDialog>(
            isNew ? "Add return to ramp" : "Edit return to ramp",
            new Dictionary<string, object?>
            {
                [nameof(ReturnToRampEditorDialog.StationId)] = stationId,
                [nameof(ReturnToRampEditorDialog.Draft)] = occurrence
            },
            new DialogOptions { Width = "1080px" });

        if (result is not ReturnToRampEditorResult saved)
            return;

        if (isNew)
        {
            model.ReturnToRamps.Add(saved.Draft);
            return;
        }

        var index = model.ReturnToRamps.IndexOf(occurrence);
        if (index >= 0)
            model.ReturnToRamps[index] = saved.Draft;
    }

    private string ReturnToRampWindow(ReturnToRampDraft occurrence)
    {
        var from = occurrence.FromLocal?.ToString("yyyy-MM-dd HH:mm") ?? "From not set";
        var to = occurrence.ToLocal?.ToString("yyyy-MM-dd HH:mm") ?? "To not set";
        return $"{from} – {to} ({UserTimeZone.Id})";
    }

    private static void AddTool(TaskForm task) => task.Tools.Add(new ResourceForm
    {
        CalculationType = ResourceCalculationType.Duration,
        Quantity = null,
        FromUtc = task.FromUtc,
        ToUtc = task.ToUtc
    });
    private void RemoveTool(TaskForm task, ResourceForm row) => task.Tools.Remove(row);
    private static void AddMaterial(TaskForm task) => task.Materials.Add(new ResourceForm());
    private void RemoveMaterial(TaskForm task, ResourceForm row) => task.Materials.Remove(row);
    private static void AddSupport(TaskForm task) => task.GeneralSupports.Add(new ResourceForm());
    private void RemoveSupport(TaskForm task, ResourceForm row) => task.GeneralSupports.Remove(row);

    private static ResourceCalculationType CalculationTypeFor(
        ResourceForm row,
        IReadOnlyList<ResourceOption> options) =>
        row.ItemId is { } itemId
            ? options.FirstOrDefault(option => option.Id == itemId)?.CalculationType ?? row.CalculationType
            : row.CalculationType;

    private static void OnResourceItemChanged(
        TaskForm task,
        ResourceForm row,
        object? value,
        IReadOnlyList<ResourceOption> options)
    {
        row.ItemId = value is Guid id ? id : null;
        row.CalculationType = CalculationTypeFor(row, options);
        if (row.CalculationType == ResourceCalculationType.Quantity)
        {
            row.Quantity ??= 1;
            row.FromUtc = null;
            row.ToUtc = null;
            return;
        }

        row.Quantity = null;
        row.FromUtc ??= task.FromUtc;
        row.ToUtc ??= task.ToUtc;
    }
    private void DeleteAttachment(TaskForm task, AttachmentForm attachment) => task.Attachments.Remove(attachment);
    private void DeleteServiceLineAttachment(ServiceLineForm line, AttachmentForm attachment) => line.Attachments.Remove(attachment);

    private async Task UploadSignatureAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;
        if (!contentType.Equals("image/png", StringComparison.OrdinalIgnoreCase) && !file.Name.EndsWith(".png", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Customer signature must be a PNG image.";
            return;
        }
        if (file.Size > 2 * 1024 * 1024)
        {
            errorMessage = "Customer signature must be at most 2 MB.";
            return;
        }

        isAttachmentBusy = true;
        errorMessage = null;
        try
        {
            await using var stream = file.OpenReadStream(2 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            model.CustomerSignature = new PendingFileForm
            {
                Content = memory.ToArray(),
                FileName = file.Name,
                ContentType = contentType,
                Size = file.Size
            };
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException)
        {
            errorMessage = "Could not read the customer signature.";
        }
        finally
        {
            isAttachmentBusy = false;
        }
    }

    private void ClearPendingSignature() => model.CustomerSignature = null;

    private async Task UploadAttachmentAsync(TaskForm task, string kind, InputFileChangeEventArgs args)
    {
        var file = args.File;
        var maxBytes = MaxAttachmentBytes(kind);
        if (file.Size > maxBytes)
        {
            errorMessage = $"{kind} attachments must be at most {FormatFileSize(maxBytes)}.";
            return;
        }

        isAttachmentBusy = true;
        errorMessage = null;
        try
        {
            await using var stream = file.OpenReadStream(maxBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            task.Attachments.Add(new AttachmentForm
            {
                Kind = kind,
                OriginalFileName = file.Name,
                ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                Size = file.Size,
                Content = memory.ToArray()
            });
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException)
        {
            errorMessage = "Could not read the attachment.";
        }
        finally
        {
            isAttachmentBusy = false;
        }
    }

    private async Task UploadServiceLineAttachmentAsync(ServiceLineForm line, string kind, InputFileChangeEventArgs args)
    {
        var file = args.File;
        var maxBytes = MaxAttachmentBytes(kind);
        if (file.Size > maxBytes)
        {
            errorMessage = $"{kind} attachments must be at most {FormatFileSize(maxBytes)}.";
            return;
        }

        isAttachmentBusy = true;
        errorMessage = null;
        try
        {
            await using var stream = file.OpenReadStream(maxBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            line.Attachments.Add(new AttachmentForm
            {
                Kind = kind,
                OriginalFileName = file.Name,
                ContentType = ResolveAttachmentContentType(file.Name, file.ContentType),
                Size = file.Size,
                Content = memory.ToArray()
            });
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException)
        {
            errorMessage = "Could not read the attachment.";
        }
        finally
        {
            isAttachmentBusy = false;
        }
    }

    private void DismissValidationMessages() => validationMessages = [];

    private void AddResourceValidation(
        List<string> messages,
        TaskForm task,
        IEnumerable<ResourceForm> rows,
        IReadOnlyList<ResourceOption> options,
        string label,
        int taskIndex)
    {
        var list = rows.ToList();
        if (list.Any(r => r.ItemId is null))
            messages.Add($"Every {label} row needs an item.");
        if (list.Where(row => row.ItemId.HasValue).GroupBy(row => row.ItemId).Any(group => group.Count() > 1))
            messages.Add($"Duplicate {label} rows are not allowed within task {taskIndex}.");

        foreach (var (row, resourceIndex) in list.Select((value, index) => (value, index + 1)))
        {
            var calculationType = CalculationTypeFor(row, options);
            var prefix = $"Task {taskIndex} {label} {resourceIndex}";
            if (calculationType == ResourceCalculationType.Quantity)
            {
                if (row.Quantity is null or <= 0)
                    messages.Add($"{prefix} quantity must be greater than zero.");
                else if (row.Quantity > 9999999999999999.99m || decimal.Round(row.Quantity.Value, 2) != row.Quantity.Value)
                    messages.Add($"{prefix} quantity supports up to 16 whole digits and 2 decimal places.");
                continue;
            }

            if (IsMissing(row.FromUtc))
                messages.Add($"{prefix} requires a From time.");
            if (!IsMissing(row.FromUtc) && !IsMissing(row.ToUtc) && row.ToUtc!.Value < row.FromUtc!.Value)
                messages.Add($"{prefix} To time cannot be before From time.");
            if (!IsMissing(task.FromUtc) && !IsMissing(row.FromUtc) && row.FromUtc!.Value < task.FromUtc!.Value)
                messages.Add($"{prefix} From time cannot be before the task From time.");
            if (!IsMissing(task.ToUtc) && !IsMissing(row.ToUtc) && row.ToUtc!.Value > task.ToUtc!.Value)
                messages.Add($"{prefix} To time cannot be after the task To time.");
        }
    }

    private string StepClass(int index) =>
        index == step ? "owf-step owf-step-active" : index < step ? "owf-step owf-step-complete" : "owf-step";

    private static string StepLabel(int index) => CompletionWorkOrderWizard.AdHocLabels[index];

    private string TypeClass(string type) => model.Type == type ? "owf-type-option owf-type-option-active" : "owf-type-option";
    private string? SelectedCustomerIata => customers.FirstOrDefault(customer => customer.Id == model.CustomerId)?.IataCode;
    private bool HasCustomerIataPrefix => !string.IsNullOrWhiteSpace(SelectedCustomerIata);
    private bool ShowCustomerFlightPrefixDivider => model.CustomerId is not null;
    private string CustomerIataPrefix => HasCustomerIataPrefix ? SelectedCustomerIata!.Trim().ToUpperInvariant() : model.CustomerId is null ? "-" : "N/A";

    private static bool IsMissing(DateTime? value) => value is null || value.Value == default;
    private DateTimeOffset? ToOffset(DateTime? value) => UserTimeZone.ToUtc(value);
    private static string NoResourceText(string title) => $"No {title.ToLowerInvariant()} added";
    private static string ToTitle(string value) => string.IsNullOrWhiteSpace(value) ? value : char.ToUpperInvariant(value[0]) + value[1..];

    private static long MaxAttachmentBytes(string kind) => kind switch
    {
        "Image" => 10 * 1024 * 1024,
        "Voice" => 25 * 1024 * 1024,
        _ => 20 * 1024 * 1024
    };

    private static string ResolveAttachmentContentType(string fileName, string? contentType)
    {
        if (!string.IsNullOrWhiteSpace(contentType))
            return contentType;

        return Path.GetExtension(fileName).ToLowerInvariant() switch
        {
            ".png" => "image/png",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".webp" => "image/webp",
            ".m4a" => "audio/mp4",
            ".mp3" => "audio/mpeg",
            ".ogg" => "audio/ogg",
            ".webm" => "audio/webm",
            ".pdf" => "application/pdf",
            _ => "application/octet-stream"
        };
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
            return $"{bytes / 1024m / 1024m:0.#} MB";
        if (bytes >= 1024)
            return $"{bytes / 1024m:0.#} KB";
        return $"{bytes} B";
    }

    private static string AttachmentIcon(string kind) => kind switch
    {
        "Image" => "image",
        "Voice" => "graphic_eq",
        "Document" => "description",
        _ => "attach_file"
    };


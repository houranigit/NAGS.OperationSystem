@implements IAsyncDisposable

<PortalWorkDialogLayout StepLabels="@StepLabels" CurrentStep="@step" ShowSteps="@(!loading && flight is not null)"
                        IsGuidedEntry="@IsGuidedEntry" Busy="@saving" StepChanged="@ChangeStep" ValidationAttempt="@validationFocusAttempt">
    <StatusContent>
        @if (loading)
        {
            <LoadingCard />
        }
        else
        {
            <ErrorState Message="@(error ?? "Could not load the return to ramp.")" OnRetry="@LoadAsync" />
        }
    </StatusContent>
    <StepContent>
        @if (flight is not null)
        {
            @if (lookups.HasUnavailableCatalogs)
            {
                <DismissibleDialogMessage AlertStyle="AlertStyle.Warning" StateKey="@("rtr-catalogs")">
                    Some reference choices are unavailable with your current permissions.
                </DismissibleDialogMessage>
            }

            @switch (step)
            {
                case 0:
                    var editArrival = CanEdit && !saving && !ArrivalFieldsLocked;
                    <section class="portal-editor-section">
                        <div class="portal-editor-heading portal-form-heading">
                            <h3 class="os-operation-section-title">
                                <RadzenIcon Icon="flight_land" aria-hidden="true" />
                                <span>Actual Arrival Details</span>
                            </h3>
                        </div>
                        <div class="portal-editor-grid">
                            <PortalOperationDateField Label="Actual time of arrival" Icon="flight_land" Time="@arrivalTime" Required="true" Disabled="@(!editArrival)"
                                                      Validation="@validation" ValidationField="@ArrivalTimeField" Changed="@RefreshValidation" />
                            @if (AdministratorEntry)
                            {
                                <PortalWorkStaffField Label="Receiving employee" Icon="person" Options="@lookups.Staff"
                                                      SavedId="@occurrence?.ReceivedByStaffMemberId" SavedName="@occurrence?.ReceivedByFullName"
                                                      @bind-Value="receivedByStaffMemberId" @bind-Value:after="RefreshValidation"
                                                      Disabled="@(!editArrival)" Validation="@validation" Field="@ReceiverField" />
                            }
                            <PortalOperationFormField Label="Arrival remarks" Class="portal-editor-full"
                                                      Validation="@validation" Field="@ArrivalRemarksField">
                                <RadzenTextArea @bind-Value="arrivalRemarks" @bind-Value:after="RefreshValidation" Immediate="true" Rows="3"
                                                Disabled="@(!editArrival)" aria-invalid="@validation.InvalidAttribute(ArrivalRemarksField)"
                                                aria-describedby="@validation.DescriptionId(ArrivalRemarksField)" />
                            </PortalOperationFormField>
                        </div>
                        @if (occurrence is { } existing)
                        {
                            <p class="portal-actuals-note">
                                Received by <strong>@existing.ReceivedByFullName</strong>.
                                @if (CanEdit && ArrivalFieldsLocked)
                                {
                                    <button type="button" class="portal-actuals-update" disabled="@saving"
                                            @onclick="@(() => arrivalUnlocked = true)">@UiStrings.Flights.UnlockToUpdate</button>
                                }
                            </p>
                        }
                    </section>
                    break;
                case 1:
                    <PortalWorkRecordsEditor FlightId="@flight.Id" Records="@services" Zone="@zone" Lookups="@lookups"
                                             AllowedServiceIds="@(AdministratorEntry ? null : flight.AllowedServiceIds)"
                                             CanAdd="@CanEdit"
                                             ReadOnly="@(!CanEdit || saving)" Validation="@validation"
                                             ValidationAttempt="@validationFocusAttempt" Changed="@RefreshValidation" />
                    break;
                case 2:
                    <PortalWorkRecordsEditor FlightId="@flight.Id" Records="@tasks" Zone="@zone" Lookups="@lookups" IsTask="true"
                                             CanAdd="@CanEdit"
                                             ReadOnly="@(!CanEdit || saving)" Validation="@validation"
                                             ValidationAttempt="@validationFocusAttempt" Changed="@RefreshValidation" />
                    break;
                case 3:
                    var editDeparture = CanEdit && !saving && !DepartureFieldsLocked;
                    <section class="portal-editor-section">
                        <div class="portal-editor-heading portal-form-heading">
                            <h3 class="os-operation-section-title">
                                <RadzenIcon Icon="flight_takeoff" aria-hidden="true" />
                                <span>Actual Departure Details</span>
                            </h3>
                        </div>
                        <div class="portal-departure-form">
                            <div class="portal-editor-grid portal-departure-fields">
                                <PortalOperationDateField Label="Actual time of departure" Icon="flight_takeoff" Time="@departureTime" Required="@RequiresDeparture"
                                                          Disabled="@(!editDeparture)" Validation="@validation" ValidationField="@DepartureTimeField"
                                                          Changed="@RefreshValidation" />
                                @if (AdministratorEntry)
                                {
                                    <PortalWorkStaffField Label="Handling employee" Icon="person" Options="@lookups.Staff"
                                                          SavedId="@occurrence?.HandledByStaffMemberId" SavedName="@occurrence?.HandledByFullName"
                                                          @bind-Value="handledByStaffMemberId" @bind-Value:after="RefreshValidation"
                                                          Required="@(RequiresDeparture || departureTime.Local.HasValue)" AllowClear="@(occurrence?.DepartedAtUtc is null)"
                                                          Disabled="@(!editDeparture)" Validation="@validation" Field="@HandlerField" />
                                }
                                <PortalOperationFormField Label="Departure remarks" Validation="@validation" Field="@DepartureRemarksField">
                                    <RadzenTextArea @bind-Value="departureRemarks" @bind-Value:after="RefreshValidation" Immediate="true" Rows="5"
                                                    Disabled="@(!editDeparture)" aria-invalid="@validation.InvalidAttribute(DepartureRemarksField)"
                                                    aria-describedby="@validation.DescriptionId(DepartureRemarksField)" />
                                </PortalOperationFormField>
                            </div>
                            <PortalWorkSignature @key="signature" FlightId="@flight.Id" Draft="@signature" UploadField="rtr-signature-upload"
                                                 Disabled="@(!editDeparture)" CanRemove="true" Changed="@RefreshValidation" />
                        </div>
                        @if (occurrence?.DepartedAtUtc is not null)
                        {
                            <p class="portal-actuals-note">
                                @if (occurrence.HandledByFullName is { } employee)
                                {
                                    <text>Handled by <strong>@employee</strong>.</text>
                                }
                                @if (CanEdit && DepartureFieldsLocked)
                                {
                                    <button type="button" class="portal-actuals-update" disabled="@saving"
                                            @onclick="@(() => departureUnlocked = true)">@UiStrings.Flights.UnlockToUpdate</button>
                                }
                            </p>
                        }
                    </section>
                    break;
            }
        }
    </StepContent>
    <FooterContent>
        @if (!loading && flight is not null)
        {
            <PortalFlightValidationSummary Validation="@validation" Attempt="@validationFocusAttempt" />
            @if (error is not null)
            {
                <DismissibleDialogMessage AlertStyle="AlertStyle.Danger" StateKey="@error" OnDismiss="@(() => error = null)">
                    @error
                </DismissibleDialogMessage>
            }

            <div class="portal-editor-actions">
                @if (IsGuidedEntry && step > 0)
                {
                    <RadzenButton Text="Previous" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Disabled="@saving"
                                  class="portal-editor-previous" Click="@(() => ChangeStep(step - 1))" />
                }
                <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Light" Disabled="@saving" Click="@CloseAsync" />
                @if (IsGuidedEntry && step + 1 < StepLabels.Length)
                {
                    <RadzenButton Text="Next" Icon="arrow_forward" ButtonStyle="ButtonStyle.Light" Disabled="@saving" Click="@NextStep" />
                }
                @if (CanEdit)
                {
                    <RadzenButton Text="@(DraftFlight is not null ? "Keep draft" : "Save RTR")" BusyText="Saving…" IsBusy="@saving" Icon="check"
                                  ButtonStyle="ButtonStyle.Primary" Click="@SaveAsync" />
                }
            </div>
        }
        else
        {
            <div class="portal-editor-actions">
                <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Light" Click="@CloseWithoutSaving" />
            </div>
        }
    </FooterContent>
</PortalWorkDialogLayout>

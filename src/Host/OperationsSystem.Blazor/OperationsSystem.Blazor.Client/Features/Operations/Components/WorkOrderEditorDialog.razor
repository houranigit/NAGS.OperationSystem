    private static long MaxAttachmentBytes(string kind) => kind switch
    {
        "Image" => 10 * 1024 * 1024,
        "Voice" => 25 * 1024 * 1024,
        _ => 20 * 1024 * 1024
    };

    private static string ResolveAttachmentContentType(string fileName, string? contentType)
    {
        var normalized = contentType?.Split(';', 2)[0].Trim().ToLowerInvariant();
        if (normalized is "image/png" or "image/jpeg" or "image/webp"
            or "audio/mp4" or "audio/mpeg" or "audio/ogg" or "audio/webm"
            or "application/pdf")
        {
            return normalized;
        }

        return Path.GetExtension(fileName).ToLowerInvariant() switch
        {
            ".png" => "image/png",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".webp" => "image/webp",
            ".m4a" => "audio/mp4",
            ".mp3" => "audio/mpeg",
            ".ogg" => "audio/ogg",
            ".webm" => "audio/webm",
            ".pdf" => "application/pdf",
            _ => "application/octet-stream"
        };
    }

    private static string CreateAttachmentDataUrl(string contentType, byte[] content) =>
        CreateAttachmentDataUrl(contentType, Convert.ToBase64String(content));

    private static string CreateAttachmentDataUrl(string contentType, string base64) =>
        $"data:{contentType};base64,{base64}";

    private static bool IsImageAttachment(AttachmentForm attachment) =>
        attachment.Kind.Equals("Image", StringComparison.OrdinalIgnoreCase)
        || attachment.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    private static bool IsAudioAttachment(AttachmentForm attachment) =>
        attachment.Kind.Equals("Voice", StringComparison.OrdinalIgnoreCase)
        || attachment.ContentType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase);

    private static bool IsPdfAttachment(AttachmentForm attachment) =>
        attachment.ContentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase)
        || attachment.OriginalFileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);

    private static string AttachmentPreviewButtonText(AttachmentForm attachment) =>
        attachment.IsPreviewOpen ? "Hide" : "Preview";

    private static string AttachmentPreviewButtonIcon(AttachmentForm attachment) =>
        attachment.IsPreviewOpen ? "visibility_off" : "visibility";

    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
            return $"{bytes / 1024m / 1024m:0.#} MB";
        if (bytes >= 1024)
            return $"{bytes / 1024m:0.#} KB";
        return $"{bytes} B";
    }

    private static string AttachmentIcon(string kind) => kind switch
    {
        "Image" => "image",
        "Voice" => "graphic_eq",
        "Document" => "description",
        _ => "attach_file"
    };


    private async Task OpenReturnToRampEditorAsync(ReturnToRampDraft occurrence, bool isNew)
    {
        if (flight is null)
            return;

        var result = await DialogService.OpenAsync<ReturnToRampEditorDialog>(
            ViewOnly ? "Return to ramp" : isNew ? "Add return to ramp" : "Edit return to ramp",
            new Dictionary<string, object?>
            {
                [nameof(ReturnToRampEditorDialog.StationId)] = flight.StationId,
                [nameof(ReturnToRampEditorDialog.Draft)] = occurrence,
                [nameof(ReturnToRampEditorDialog.WorkOrderId)] = WorkOrderId,
                [nameof(ReturnToRampEditorDialog.WorkOrderRowVersion)] = workOrder?.RowVersion,
                [nameof(ReturnToRampEditorDialog.WorkOrderRowVersionChanged)] = EventCallback.Factory.Create<string>(this, UpdateWorkOrderRowVersion),
                [nameof(ReturnToRampEditorDialog.ViewOnly)] = ViewOnly
            },
            new DialogOptions { Width = "1080px" });

        if (ViewOnly || result is not ReturnToRampEditorResult saved)
            return;

        if (isNew)
        {
            model.ReturnToRamps.Add(saved.Draft);
        }
        else
        {
            var index = model.ReturnToRamps.IndexOf(occurrence);
            if (index >= 0)
                model.ReturnToRamps[index] = saved.Draft;
        }

        if (workOrder is not null && !string.IsNullOrWhiteSpace(saved.WorkOrderRowVersion))
            workOrder = workOrder with { RowVersion = saved.WorkOrderRowVersion };
    }


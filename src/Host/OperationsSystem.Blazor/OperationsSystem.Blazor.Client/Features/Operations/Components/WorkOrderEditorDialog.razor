            Materials = t.Materials.Select(x => new ResourceForm
            {
                ItemId = x.MaterialId,
                CalculationType = x.CalculationType,
                Quantity = x.Quantity,
                FromUtc = UserTimeZone.ToLocalDateTime(x.FromUtc),
                ToUtc = UserTimeZone.ToLocalDateTime(x.ToUtc)
            }).ToList(),
            GeneralSupports = t.GeneralSupports.Select(x => new ResourceForm
            {
                ItemId = x.GeneralSupportId,
                CalculationType = x.CalculationType,
                Quantity = x.Quantity,
                FromUtc = UserTimeZone.ToLocalDateTime(x.FromUtc),
                ToUtc = UserTimeZone.ToLocalDateTime(x.ToUtc)
            }).ToList(),
            Attachments = t.Attachments.Select(a => new AttachmentForm
            {
                Id = a.Id,
                Kind = a.Kind,
                OriginalFileName = a.OriginalFileName,
                ContentType = a.ContentType,

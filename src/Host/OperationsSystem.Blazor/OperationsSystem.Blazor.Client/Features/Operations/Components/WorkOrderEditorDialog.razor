    private WorkOrderFormModel NewModel(
        FlightDetail flight,
        string type,
        IReadOnlySet<Guid> allowedPerformedServiceIds) => new()
    {
        Type = string.IsNullOrWhiteSpace(type) ? "Completion" : type,
        ActualFlightNumber = flight.FlightNumber,

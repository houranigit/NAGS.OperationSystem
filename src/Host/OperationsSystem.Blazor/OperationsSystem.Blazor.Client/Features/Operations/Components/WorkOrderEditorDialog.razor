                flight.IsPerLanding,
                flight.PlannedServices,
                allowedPerformedServiceIds)
            .Select(service => new ServiceLineForm
            {
                ServiceId = service.ServiceId,
                FromUtc = UserTimeZone.ToLocalDateTime(flight.ScheduledArrivalUtc),
                ToUtc = UserTimeZone.ToLocalDateTime(flight.ScheduledDepartureUtc)
            })
            .ToList()
    };


            ServiceName = l.ServiceName,
            PerformedByStaffMemberIds = l.PerformedBy.Select(performer => performer.StaffMemberId).ToList(),
            FromUtc = UserTimeZone.ToLocalDateTime(l.FromUtc),
            ToUtc = UserTimeZone.ToLocalDateTime(l.ToUtc),
            Description = l.Description,
            Attachments = (l.Attachments ?? []).Select(a => new AttachmentForm
            {
                Id = a.Id,
                Kind = a.Kind,
                OriginalFileName = a.OriginalFileName,

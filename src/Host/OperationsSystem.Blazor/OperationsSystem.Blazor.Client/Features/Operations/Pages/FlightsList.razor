@page "/operations/flights"
@using OperationsSystem.Blazor.Client.Features.Operations
@implements IAsyncDisposable
@inject OperationsApiClient Operations
@inject MasterDataApiClient MasterData
@inject DialogService DialogService
@inject NotificationService Notifications
@inject GridPreferences GridPrefs
@inject AuthSession Auth

<PageTitle>@PageName</PageTitle>

<RequirePermission Permission="@OperationsPermissions.FlightsView">
    <div class="@(WorkOrdersOnly ? "os-list-page ofl-work-orders" : "os-list-page")">
        <PageHeader Title="@PageName" Section="@UiStrings.Nav.Operations">
            <Actions>
                @if (!WorkOrdersOnly)
                {
                    <AuthorizeView Context="schedule">
                        @if (schedule.User.HasClaim(PortalAuthStateProvider.PermissionClaimType, OperationsPermissions.FlightsSchedule))
                        {
                            <RadzenButton Text="Schedule flights" Icon="event_repeat" ButtonStyle="ButtonStyle.Light" class="ofl-schedule-bulk-button" Click="@OpenBulkScheduleAsync" />
                            <RadzenButton Text="Schedule flight" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@OpenScheduleAsync" />
                        }
                    </AuthorizeView>
                }
            </Actions>
        </PageHeader>

        <DataListCard @ref="list" TItem="FlightListItem" Data="@items" Count="@totalCount" IsLoading="@isLoading"
                      HasError="@loadError" OnRetry="@ReloadAsync" LoadData="@LoadDataAsync"
                      PageSize="@currentPageSize" PageSizeReady="@pageSizeReady" PageSizeChanged="@OnPageSizeChangedAsync"
                      PageSizeText="@ResultCountText"
                      ColumnLayoutKey="@ColumnLayoutKey" PreviousColumnLayoutKeys="@(WorkOrdersOnly ? PreviousWorkOrderLayoutKeys : [])"
                      CellRender="@(WorkOrdersOnly ? RenderWorkOrderCell : null)"
                      SearchValue="@searchTerm" SearchValueChanged="@(v => searchTerm = v)" OnSearch="@ReloadAsync"
                      SearchPlaceholder="@SearchPlaceholder" CountLabel="@CountLabel" EmptyText="@EmptyText"
                      UseCollapsibleFilters="true" ActiveFilterCount="@ActiveFilterCount" OnClearFilters="@ClearFiltersAsync"
                      ToolbarPanelLabel="@(CanExport ? UiStrings.Flights.Export : null)" ToolbarPanelIcon="download">
            <Toolbar>
                <div class="ofl-flight-type">
                    <RadzenSelectBar TValue="FlightType" Value="@flightType" ValueChanged="@OnFlightTypeChangedAsync"
                                     AriaLabel="@UiStrings.Flights.FlightType">
                        <Items>
                            <RadzenSelectBarItem Value="@FlightType.All" Text="@UiStrings.Flights.TypeAll" />
                            <RadzenSelectBarItem Value="@FlightType.Scheduled" Text="@UiStrings.Flights.TypeScheduled" />
                            <RadzenSelectBarItem Value="@FlightType.PerLanding" Text="@UiStrings.Flights.TypePerLanding" />
                            <RadzenSelectBarItem Value="@FlightType.OnCall" Text="@UiStrings.Flights.TypeOnCall" />
                            <RadzenSelectBarItem Value="@FlightType.AdHoc" Text="@UiStrings.Flights.TypeAdHoc" />
                        </Items>
                    </RadzenSelectBar>
                </div>
            </Toolbar>
            <ToolbarPanel>
                <div class="ofl-export-options" aria-busy="@(isExporting ? "true" : "false")">
                    <RadzenButton Text="@UiStrings.Flights.ExcelWorkbook" Icon="table_view" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Light"
                                  Disabled="@(!ExportAvailable)" Click="@(() => ExportAsync("xlsx", UiStrings.Flights.ExcelWorkbook))" />
                    <RadzenButton Text="@UiStrings.Flights.CsvFile" Icon="csv" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Light"
                                  Disabled="@(!ExportAvailable)" Click="@(() => ExportAsync("csv", UiStrings.Flights.CsvFile))" />
                    <RadzenButton Text="@UiStrings.Flights.PdfReport" Icon="picture_as_pdf" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Light"
                                  Disabled="@(!ExportAvailable)" Click="@(() => ExportAsync("pdf", UiStrings.Flights.PdfReport))" />
                    <RadzenButton Text="@UiStrings.Flights.ExportBilling" Icon="receipt_long" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Light"
                                  Disabled="@(!ExportAvailable)" Click="@(() => ExportAsync("xlsx", UiStrings.Flights.ExportBilling, "billing"))" />
                </div>
                @if (isExporting)
                {
                    <span class="ofl-export-feedback" role="status">@UiStrings.Flights.Exporting</span>
                }
                else if (exportMessage is not null)
                {
                    <span class="@(exportFailed ? "ofl-export-feedback ofl-export-error" : "ofl-export-feedback")"
                          role="@(exportFailed ? "alert" : "status")">
                        <strong>@(exportFailed ? UiStrings.Flights.ExportFailed : UiStrings.Flights.ExportReady)</strong> @exportMessage
                    </span>
                }
            </ToolbarPanel>
            <Filters>
                <div class="ofl-filters">
                    <DataListFilter TValue="Guid?" Placeholder="All stations" Data="@stationOptions" Value="@stationFilter" ValueChanged="@OnStationFilterChangedAsync" />
                    <DataListFilter TValue="Guid?" Placeholder="All customers" Data="@customerOptions" Value="@customerFilter" ValueChanged="@OnCustomerFilterChangedAsync" AllowFiltering="true" />
                    <DataListFilter TValue="IEnumerable<string>" Placeholder="All statuses" Data="@statusOptions" Value="@statusFilters" ValueChanged="@OnStatusFilterChangedAsync" Multiple="true" Chips="true" />
                    <DataListFilter TValue="Guid?" Placeholder="All operations" Data="@operationTypeOptions" Value="@operationTypeFilter" ValueChanged="@OnOperationTypeFilterChangedAsync" />
                    <RadzenDatePicker Disabled="@(stationFilter is null)" TValue="DateTime?" Value="@fromFilter" Change="@OnFromFilterChangedAsync"
                                      DateFormat="yyyy-MM-dd" ShowTime="false" AllowClear="true"
                                      Placeholder="From date" class="ofl-date-filter" />
                    <RadzenDatePicker Disabled="@(stationFilter is null)" TValue="DateTime?" Value="@toFilter" Change="@OnToFilterChangedAsync"
                                      DateFormat="yyyy-MM-dd" ShowTime="false" AllowClear="true"
                                      Placeholder="To date" class="ofl-date-filter" />
                </div>
            </Filters>
            <Columns>
                <RadzenDataGridColumn TItem="FlightListItem" Property="FlightNumber" UniqueID="flight-number" Title="Flight #"
                                      Reorderable="@(!WorkOrdersOnly)" MinWidth="@(WorkOrdersOnly ? "200px" : "120px")">
                    <Template Context="flight">
                        @{
                            var type = FlightTypeBadge(flight);
                        }
                        <div class="os-role-cell">
                            <span class="os-role-cell-icon"><RadzenIcon Icon="flight" /></span>
                            <div class="os-role-cell-text">
                                <div class="os-role-cell-title">
                                    <strong>@flight.FlightNumber</strong>
                                    <span class="ofl-flight-type-badges">
                                        <span class="ofl-flight-type-badge os-pill--@type.Tone" title="@type.Label" role="img" aria-label="@type.Label">@type.Abbreviation</span>
                                        @if (flight.IsOnCall)
                                        {
                                            <span class="ofl-flight-type-badge ofl-on-call-badge os-pill--success" title="@UiStrings.Flights.TypeOnCall"
                                                  role="img" aria-label="@UiStrings.Flights.TypeOnCall">
                                                <RadzenIcon Icon="call" class="ofl-on-call-icon" aria-hidden="true" />
                                            </span>
                                        }
                                    </span>
                                </div>
                                @if (WorkOrdersOnly)
                                {
                                    <span class="ofl-order-meta" title="@flight.CustomerName">@flight.CustomerName</span>
                                }
                                else
                                {
                                    var timedStatus = FlightStatusTime.At(flight, statusTimeUtc);
                                    var status = statusOptions.FirstOrDefault(option => option.Value == timedStatus.Status);
                                    var statusText = timedStatus.Text ?? status?.Label ?? timedStatus.Status ?? "—";
                                    <span class="ofl-flight-status os-pill--@(status?.Tone ?? "neutral")" title="@statusText">@statusText</span>
                                }
                            </div>
                        </div>
                    </Template>
                </RadzenDataGridColumn>
                @if (WorkOrdersOnly)
                {
                    <RadzenDataGridColumn TItem="FlightListItem" UniqueID="@ScheduledTimesColumnId" Title="S. Times"
                                          Sortable="false" Reorderable="false" Width="180px">
                        <Template Context="flight">
                            @if (IsCancellationOnly(flight))
                            {
                                @CancellationSummary(flight)
                            }
                            else
                            {
                                var zone = StationTimeZone.FromId(flight.StationTimeZoneId);
                                <div class="ofl-order-times">
                                    @OrderTime("STA", flight.ScheduledArrivalUtc, zone)
                                    @OrderTime("STD", flight.ScheduledDepartureUtc, zone)
                                </div>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="FlightListItem" UniqueID="@ActualTimesColumnId" Title="A. Times"
                                          Sortable="false" Width="260px" MinWidth="240px">
                        <Template Context="flight">
                            @{ var zone = StationTimeZone.FromId(flight.StationTimeZoneId); }
                            <div class="ofl-order-times">
                                @OrderTime("ATA", flight.ActualArrivalUtc, zone, flight.ScheduledArrivalUtc)
                                @OrderTime("ATD", flight.ActualDepartureUtc, zone, flight.ScheduledDepartureUtc, showOnGround: true)
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="FlightListItem" UniqueID="@RecordedWorkColumnId" Title="Work" Sortable="false" Width="100px">
                        <Template Context="flight">
                            <div class="ofl-order-work">
                                <span class="@(flight.HasOpenServiceRecords ? "ofl-order-open-work" : null)"
                                      title="@(flight.HasOpenServiceRecords ? "Includes open services" : null)">@flight.ServiceRecordCount @(flight.ServiceRecordCount == 1 ? "service" : "services")</span>
                                <span class="@(flight.HasOpenTaskRecords ? "ofl-order-open-work" : null)"
                                      title="@(flight.HasOpenTaskRecords ? "Includes open tasks" : null)">@flight.TaskRecordCount @(flight.TaskRecordCount == 1 ? "task" : "tasks")</span>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                }
                else
                {
                    <RadzenDataGridColumn TItem="FlightListItem" Property="CustomerName" UniqueID="customer" Title="@UiStrings.Flights.Customer" Width="180px" />
                    <RadzenDataGridColumn TItem="FlightListItem" Property="StationIataCode" UniqueID="station" Title="Station" Width="120px" />
                    <RadzenDataGridColumn TItem="FlightListItem" Property="OperationTypeName" UniqueID="operation" Title="Operation" Width="120px" />
                    <RadzenDataGridColumn TItem="FlightListItem" UniqueID="duration" Title="Duration" Sortable="false" Width="120px">
                        <Template Context="flight">@DurationDisplay(flight)</Template>
                    </RadzenDataGridColumn>
                }
                <RadzenDataGridColumn TItem="FlightListItem" Property="@nameof(FlightListItem.ApprovalStatus)" UniqueID="approval-status"
                                      Title="Status" Sortable="@WorkOrdersOnly" Reorderable="@(!WorkOrdersOnly)" Width="160px">
                    <Template Context="flight">
                        @{
                            var approval = ApprovalBadge(flight.ApprovalStatus);
                        }
                        <StatusBadge Label="@approval.Label" Tone="@approval.Tone" Icon="@approval.Icon" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FlightListItem" Property="@nameof(FlightListItem.WorkOrderNumber)" UniqueID="work-order"
                                      Title="@(WorkOrdersOnly ? "WO #" : "WO#")" Reorderable="@(!WorkOrdersOnly)"
                                      Sortable="@WorkOrdersOnly" Width="120px">
                    <Template Context="flight">
                        @if (WorkOrdersOnly)
                        {
                            @WorkOrderNumber(flight)
                            @if (flight.HasCancellationSubmission && flight.HasWorkOrderRecords)
                            {
                                <span class="ofl-order-meta" title="@ConflictDetails(flight)">Work &amp; cancellation</span>
                            }
                        }
                        else if (flight.WorkOrderNumber is { } number)
                        {
                            <strong>@number</strong>
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
            <RowActions Context="flight">
                @if (flight.HasOperationalRecords || flight.IsAutoClosed || CanOpenFlightOperations || CanEditSchedule)
                {
                    <RowActionMenu>
                        <ChildContent>
                            @if (CanEditSchedule)
                            {
                                <RowAction Text="Edit schedule" Icon="edit" Permission="@OperationsPermissions.FlightsUpdate"
                                           OnClick="@(() => OpenEditAsync(flight.Id))" />
                            }
                        </ChildContent>
                        <MenuContent>
                            @if (flight.HasOperationalRecords || flight.IsAutoClosed || CanOpenFlightOperations)
                            {
                                <PortalFlightOperationsMenu @key="flight.Id" Flight="@flight" ShowWorkActions="@CanOpenFlightOperations"
                                    ShowDivider="@CanEditSchedule" WorkOrdersOnly="@WorkOrdersOnly" Changed="@ReloadAsync" />
                            }
                        </MenuContent>
                    </RowActionMenu>
                }
            </RowActions>
        </DataListCard>
    </div>
</RequirePermission>

@code {
    [Parameter] public bool WorkOrdersOnly { get; set; }
    [SupplyParameterFromQuery(Name = "search")] private string? SearchQuery { get; set; }

    private const string WorkOrdersGridKey = "operations-work-orders";
    private static readonly string[] PreviousWorkOrderLayoutKeys = [$"{WorkOrdersGridKey}-v2", WorkOrdersGridKey];
    private string GridKey => WorkOrdersOnly ? WorkOrdersGridKey : "operations-flights";
    private string ColumnLayoutKey => WorkOrdersOnly ? $"{WorkOrdersGridKey}-v3" : GridKey;
    private string PageName => WorkOrdersOnly ? "Work Orders" : "Flights";
    private string SearchPlaceholder => WorkOrdersOnly
        ? "Search WO number, flight number, customer, or ID"
        : "Search flight number, customer, or ID";
    private string CountLabel => WorkOrdersOnly ? "flights with orders" : "flights";
    private string EmptyText => WorkOrdersOnly ? "No work or cancellation orders match your filters." : "No flights match your filters.";
    private const string ScheduledTimesColumnId = "scheduled-times";
    private const string ActualTimesColumnId = "recorded-times";
    private const string RecordedWorkColumnId = "recorded-work";
    private static readonly int[] PageSizes = [10, 25, 50, 100];
    private readonly StatusFilterOption[] statusOptions =
    [
        new("Scheduled", "Scheduled", "gray"),
        new("Due soon", "DueSoon", "warning"),
        new(UiStrings.Flights.AwaitingAta, "ArrivalNotRecorded", "orange"),
        new("On ground", "OnGround", "info"),
        new("RTR", "ReturnedToRamp", "purple"),
        new("Departed", "Departed", "slate"),
        new(UiStrings.Flights.AutoClosed, FlightListItem.AutoClosedStatus, "slate"),
        new("Canceled", "Canceled", "danger"),
        new("Conflict", "Conflict", "critical")
    ];

    private enum FlightType { All, Scheduled, PerLanding, OnCall, AdHoc }

    private DataListCard<FlightListItem>? list;
    private IReadOnlyList<FlightListItem> items = [];
    private int totalCount;
    private readonly CancellationTokenSource statusClockCancellation = new();
    private Task? statusClockTask;
    private DateTimeOffset statusTimeUtc = DateTimeOffset.UtcNow;
    private long loadRequest;
    private FlightType flightType = FlightType.All;
    private bool isLoading;
    private bool loadError;
    private bool isExporting;
    private bool exportFailed;
    private string? exportMessage;
    private string searchTerm = string.Empty;
    private string? appliedSearchQuery;
    private Guid? stationFilter;
    private Guid? customerFilter;
    private IReadOnlyList<string> statusFilters = [];
    private Guid? operationTypeFilter;
    private DateTime? fromFilter;
    private DateTime? toFilter;
    private int currentPage = 1;
    private int currentPageSize = GridPreferences.DefaultPageSize;
    private bool pageSizeReady;
    private string? currentSort;
    private IReadOnlyList<StationFilterOption> stationOptions = [];
    private IReadOnlyList<CustomerFilterOption> customerOptions = [];
    private IReadOnlyList<OperationTypeFilterOption> operationTypeOptions = [];
    private bool CanEditSchedule => !WorkOrdersOnly && Auth.HasPermission(OperationsPermissions.FlightsUpdate);
    private bool CanExport => Auth.HasPermission(OperationsPermissions.FlightsExport);
    private bool ExportAvailable => CanExport && !isExporting && !isLoading && !loadError && totalCount > 0;
    private string? SearchFilter => string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm;
    private string? FlightTypeFilter => flightType == FlightType.All ? null : flightType.ToString();
    private bool CanOpenFlightOperations => Auth.IsSystemAdministrator
        ? Auth.HasPermission(OperationsPermissions.FlightsView)
        : Auth.HasPermission(OperationsPermissions.FlightsApprove)
          || Auth.User is { UserType: UserTypes.StationStaff, ExternalReferenceId: not null }
          && Auth.HasPermission(OperationsPermissions.FlightsOperate);

    private static (string Abbreviation, string Label, string Tone) FlightTypeBadge(FlightListItem flight)
    {
        if (flight.IsAdHocFlight)
            return ("AD", UiStrings.Flights.TypeAdHoc, "danger");

        return flight.IsPerLanding
            ? ("PL", UiStrings.Flights.TypePerLanding, "orange")
            : ("S", UiStrings.Flights.TypeScheduled, "info");
    }

    private static (string Label, string Tone, string? Icon) ApprovalBadge(string? status) => status switch
    {
        FlightApprovalStatuses.Approved => ("Approved", "success", "lock"),
        FlightApprovalStatuses.Unlocked => ("Unlocked", "info", "lock_open"),
        FlightApprovalStatuses.PendingRtr => ("Pending RTR", "warning", "lock"),
        _ => ("Not Approved", "gray", null)
    };

    private string ResultCountText => WorkOrdersOnly ? $"{totalCount:N0} {CountLabel}" : UiStrings.Flights.TotalCount(totalCount);

    private static bool IsCancellationOnly(FlightListItem flight) => flight.HasCancellationSubmission && !flight.HasWorkOrderRecords;

    private static void RenderWorkOrderCell(DataGridCellRenderEventArgs<FlightListItem> args)
    {
        if (args.Data is not { } flight || !IsCancellationOnly(flight) || args.Column is not { } column)
            return;

        if (column.UniqueID == ScheduledTimesColumnId)
        {
            args.Attributes["colspan"] = column.Grid.ColumnsCollection.Count(item => item.GetVisible()
                && item.UniqueID is ScheduledTimesColumnId or ActualTimesColumnId or RecordedWorkColumnId);
            args.Attributes["class"] = "ofl-cancellation-cell";
        }
        else if (column.UniqueID is ActualTimesColumnId or RecordedWorkColumnId)
        {
            args.Attributes["style"] = "display:none";
        }
    }

    private static string CancellationLabel(string? type) => type switch
    {
        "Planned" => "Planned cancellation",
        "Unplanned" => "Unplanned cancellation",
        _ => "Cancellation order"
    };

    private static RenderFragment CancellationSummary(FlightListItem flight) =>
        @<div class="ofl-cancellation-summary">
            <RadzenIcon Icon="event_busy" aria-hidden="true" />
            <strong>@CancellationLabel(flight.CancellationType)</strong>
            @if (flight.CanceledAtUtc is { } canceledAt)
            {
                <time datetime="@canceledAt.ToString("O")">@StationTimeZone.FromId(flight.StationTimeZoneId).Format(canceledAt, "dd MMM yyyy HH:mm")</time>
            }
        </div>;

    private static RenderFragment WorkOrderNumber(FlightListItem flight) =>
        @<text>
            @if (!string.IsNullOrWhiteSpace(flight.WorkOrderNumber))
            {
                <strong>@flight.WorkOrderNumber</strong>
            }
            else
            {
                <span class="ofl-order-unissued" title="Work order number not issued">@flight.StationIataCode - ____</span>
            }
        </text>;

    private static RenderFragment OrderTime(string label, DateTimeOffset? timestamp, StationTimeZone zone,
        DateTimeOffset? scheduled = null, bool showOnGround = false) =>
        @<div class="ofl-order-time">
            <span>@label</span>
            @if (timestamp is { } value)
            {
                <time datetime="@value.ToString("O")">@zone.Format(value, "dd MMM yyyy HH:mm")</time>
                @if (scheduled is { } scheduledTime)
                {
                    @ScheduleDifference(value - scheduledTime)
                }
            }
            else if (showOnGround)
            {
                <span class="ofl-order-on-ground">Still on ground</span>
            }
            else
            {
                <span>—</span>
            }
        </div>;

    private static RenderFragment ScheduleDifference(TimeSpan difference) =>
        @<text>
            @{
                var minutes = (long)Math.Round(difference.TotalMinutes, MidpointRounding.AwayFromZero);
            }
            @if (minutes != 0)
            {
                var (hours, remainder) = Math.DivRem(Math.Abs(minutes), 60);
                var duration = hours == 0 ? $"{remainder}m" : remainder == 0 ? $"{hours}h" : $"{hours}h {remainder}m";
                var late = minutes > 0;
                <span class="ofl-order-difference @(late ? "ofl-order-late" : "ofl-order-early")"
                      title="@($"{duration} {(late ? "late" : "early")}")">@(late ? "+" : "−")@duration</span>
            }
        </text>;

    private static string ConflictDetails(FlightListItem flight) => flight.CanceledAtUtc is { } timestamp
        ? $"{CancellationLabel(flight.CancellationType)} · {StationTimeZone.FromId(flight.StationTimeZoneId).Format(timestamp, "dd MMM yyyy HH:mm")}"
        : "Work and cancellation orders";

    private int ActiveFilterCount =>
        (stationFilter.HasValue ? 1 : 0)
        + (customerFilter.HasValue ? 1 : 0)
        + (statusFilters.Count > 0 ? 1 : 0)
        + (operationTypeFilter.HasValue ? 1 : 0)
        + (fromFilter.HasValue ? 1 : 0)
        + (toFilter.HasValue ? 1 : 0);

    protected override async Task OnInitializedAsync()
    {
        appliedSearchQuery = SearchQuery;
        searchTerm = SearchQuery ?? string.Empty;
        currentPageSize = await GridPrefs.GetPageSizeAsync(GridKey, currentPageSize, PageSizes);
        pageSizeReady = true;
        await Task.WhenAll(
            LoadStationOptionsAsync(),
            LoadCustomerOptionsAsync(),
            LoadOperationTypeOptionsAsync());

        await FetchAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(appliedSearchQuery, SearchQuery, StringComparison.Ordinal))
            return;

        appliedSearchQuery = SearchQuery;
        searchTerm = SearchQuery ?? string.Empty;
        await ReloadAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !WorkOrdersOnly)
            statusClockTask = UpdateStatusClockAsync(statusClockCancellation.Token);

        return Task.CompletedTask;
    }

    private async Task UpdateStatusClockAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                var now = DateTimeOffset.UtcNow;
                var toNextMinute = TimeSpan.FromTicks(TimeSpan.TicksPerMinute - now.Ticks % TimeSpan.TicksPerMinute);
                await Task.Delay(toNextMinute, cancellationToken);
                statusTimeUtc = DateTimeOffset.UtcNow;
                if (items.Count > 0)
                    StateHasChanged();
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        statusClockCancellation.Cancel();
        if (statusClockTask is not null)
            await statusClockTask;
        statusClockCancellation.Dispose();
    }

    private bool CanLoadLookup(string resourceViewPermission) =>
        Auth.HasPermission(MasterDataPermissions.ReferenceViewOptions) || Auth.HasPermission(resourceViewPermission);

    private async Task LoadStationOptionsAsync()
    {
        if (!CanLoadLookup(MasterDataPermissions.StationsView))
            return;

        try
        {
            stationOptions = (await MasterData.GetStationOptionsAsync())
                .Select(x => new StationFilterOption($"{x.IataCode} · {x.Name}", x.Id, x.TimeZoneId))
                .ToList();
        }
        catch (ApiException)
        {
            stationOptions = [];
        }
    }

    private async Task LoadCustomerOptionsAsync()
    {
        if (!CanLoadLookup(MasterDataPermissions.CustomersView))
            return;

        try
        {
            customerOptions = (await MasterData.GetCustomerOptionsAsync())
                .Select(x => new CustomerFilterOption(CustomerFilterLabel(x), x.Id))
                .ToList();
        }
        catch (ApiException)
        {
            customerOptions = [];
        }
    }

    private async Task LoadOperationTypeOptionsAsync()
    {
        if (!CanLoadLookup(MasterDataPermissions.OperationTypesView))
            return;

        try
        {
            operationTypeOptions = (await MasterData.GetOperationTypeOptionsAsync())
                .Select(x => new OperationTypeFilterOption(x.Name, x.Id))
                .ToList();
        }
        catch (ApiException)
        {
            operationTypeOptions = [];
        }
    }

    private async Task OnPageSizeChangedAsync(int pageSize)
    {
        currentPageSize = pageSize;
        await GridPrefs.SetPageSizeAsync(GridKey, pageSize);
    }

    private async Task OnStationFilterChangedAsync(Guid? value)
    {
        stationFilter = value;
        if (stationFilter is null)
        {
            fromFilter = null;
            toFilter = null;
        }
        await ReloadAsync();
    }

    private async Task OnCustomerFilterChangedAsync(Guid? value)
    {
        customerFilter = value;
        await ReloadAsync();
    }

    private async Task OnStatusFilterChangedAsync(IEnumerable<string>? values)
    {
        statusFilters = values?.Distinct().ToList() ?? [];
        await ReloadAsync();
    }

    private async Task OnOperationTypeFilterChangedAsync(Guid? value)
    {
        operationTypeFilter = value;
        await ReloadAsync();
    }

    private async Task OnFromFilterChangedAsync(DateTime? value)
    {
        fromFilter = value;
        await ReloadAsync();
    }

    private async Task OnToFilterChangedAsync(DateTime? value)
    {
        toFilter = value;
        await ReloadAsync();
    }

    private async Task ClearFiltersAsync()
    {
        if (ActiveFilterCount == 0)
            return;

        stationFilter = null;
        customerFilter = null;
        statusFilters = [];
        operationTypeFilter = null;
        fromFilter = null;
        toFilter = null;

        await ReloadAsync();
    }

    private async Task OnFlightTypeChangedAsync(FlightType value)
    {
        if (flightType == value)
            return;

        flightType = value;
        await ReloadAsync();
    }

    private async Task ExportAsync(string format, string formatLabel, string? report = null)
    {
        if (!ExportAvailable)
            return;

        isExporting = true;
        exportMessage = null;
        exportFailed = false;
        try
        {
            await Operations.DownloadFlightsExportAsync(format, SearchFilter, stationFilter, customerFilter, operationTypeFilter,
                DateBoundaryUtc(fromFilter, false), DateBoundaryUtc(toFilter, true), currentSort, statusFilters, FlightTypeFilter, report,
                workOrdersOnly: WorkOrdersOnly);
            exportMessage = string.Format(UiStrings.Flights.ExportReadyDetail, formatLabel);
        }
        catch (ApiException ex)
        {
            exportFailed = true;
            exportMessage = ex.ToDisplayMessage(UiStrings.Flights.ExportFailedDetail);
        }
        catch (JSException)
        {
            exportFailed = true;
            exportMessage = UiStrings.Flights.ExportFailedDetail;
        }
        finally
        {
            isExporting = false;
        }
    }

    private async Task LoadDataAsync(LoadDataArgs args)
    {
        currentPageSize = args.Top ?? currentPageSize;
        currentPage = ((args.Skip ?? 0) / Math.Max(currentPageSize, 1)) + 1;
        currentSort = SortBuilder.From(args);
        await FetchAsync();
    }

    private async Task ReloadAsync()
    {
        currentPage = 1;
        if (list is not null)
            await list.ReloadAsync();
        else
            await FetchAsync();
    }

    private async Task FetchAsync()
    {
        var request = ++loadRequest;
        isLoading = true;
        loadError = false;
        StateHasChanged();

        try
        {
            var result = await Operations.GetFlightsAsync(currentPage, currentPageSize,
                SearchFilter, stationFilter, customerFilter, operationTypeFilter,
                DateBoundaryUtc(fromFilter, false), DateBoundaryUtc(toFilter, true), currentSort, statuses: statusFilters,
                flightType: FlightTypeFilter, workOrdersOnly: WorkOrdersOnly);
            if (request != loadRequest)
                return;

            statusTimeUtc = DateTimeOffset.UtcNow;
            items = result.Items;
            totalCount = (int)result.TotalCount;
        }
        catch (ApiException)
        {
            if (request == loadRequest)
                loadError = true;
        }
        finally
        {
            if (request == loadRequest)
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task OpenScheduleAsync()
    {
        var result = await DialogService.OpenAsync<ScheduleFlightDialog>("Schedule flight", null, new DialogOptions { Width = "760px" });
        if (result is true)
        {
            Notifications.Notify(NotificationSeverity.Success, "Flight scheduled");
            await ReloadAsync();
        }

@page "/operations/dashboard"

<PageTitle>@UiStrings.OperationsDashboard.Title</PageTitle>

<RequirePermission Permission="@OperationsPermissions.DashboardAnalyticsView">
    <main class="od-page">
        <header class="od-page-header">
            <div class="od-page-heading">
                <span class="od-eyebrow">
                    <RadzenIcon Icon="monitoring" />
                    @UiStrings.OperationsDashboard.ExecutiveOverview
                </span>
                <h1>@UiStrings.OperationsDashboard.Title</h1>
                <p>@UiStrings.OperationsDashboard.Description</p>
            </div>

            <div class="od-header-actions">
                <div class="@RealtimeClass" role="status">
                    <span class="od-live-dot"></span>
                    <div>
                        <strong>@RealtimeLabel</strong>
                        <small>@UiStrings.OperationsDashboard.RealtimeDescription</small>
                    </div>
                </div>
                <div class="od-updated">
                    <span>@UiStrings.OperationsDashboard.LastUpdated</span>
                    <strong>@LastUpdatedLabel</strong>
                </div>
                <button type="button"
                        class="od-icon-button"
                        title="@UiStrings.OperationsDashboard.Refresh"
                        disabled="@isRefreshing"
                        @onclick="RefreshEverythingAsync">
                    <RadzenIcon Icon="refresh" />
                </button>
            </div>
        </header>

        <section class="od-filter-bar" aria-label="@UiStrings.OperationsDashboard.GlobalFilter">
            <div class="od-filter-topline">
                <div class="od-period-presets" role="group" aria-label="@UiStrings.OperationsDashboard.PeriodShortcuts">
                    @foreach (var option in PeriodPresets)
                    {
                        <button type="button"
                                class="@PeriodPresetClass(option.Value)"
                                aria-pressed="@(selectedPreset == option.Value)"
                                disabled="@isRefreshing"
                                @onclick="() => SelectPeriodPresetAsync(option.Value)">
                            @option.Label
                        </button>
                    }
                </div>

                <div class="od-filter-summary">
                    <RadzenIcon Icon="date_range" />
                    <span>@RangeSummary</span>
                    <span class="od-utc-badge"
                          title="@UiStrings.OperationsDashboard.UtcReporting"
                          aria-label="@UiStrings.OperationsDashboard.UtcReporting">UTC</span>
                </div>
            </div>

            <div class="od-filter-grid">
                <div class="od-date-control">
                    <div class="od-date-modes" role="group" aria-label="@UiStrings.OperationsDashboard.DateMode">
                        <button type="button"
                                class="@DateModeClass(DashboardDateMode.Day)"
                                aria-pressed="@(dateMode == DashboardDateMode.Day)"
                                @onclick="() => SelectDateModeAsync(DashboardDateMode.Day)">
                            @UiStrings.OperationsDashboard.Day
                        </button>
                        <button type="button"
                                class="@DateModeClass(DashboardDateMode.Range)"
                                aria-pressed="@(dateMode == DashboardDateMode.Range)"
                                @onclick="() => SelectDateModeAsync(DashboardDateMode.Range)">
                            @UiStrings.OperationsDashboard.Range
                        </button>
                    </div>

                    @if (dateMode == DashboardDateMode.Day)
                    {
                        <label class="od-date-field">
                            <span>@UiStrings.OperationsDashboard.Date</span>
                            <RadzenDatePicker TValue="DateTime?"
                                              Value="@selectedDay"
                                              Change="@OnDayChangedAsync"
                                              DateFormat="dd MMM yyyy"
                                              ShowTime="false"
                                              AllowClear="false"
                                              Placeholder="@UiStrings.OperationsDashboard.SelectDay"
                                              aria-label="@UiStrings.OperationsDashboard.Date"
                                              class="od-date-picker"
                                              data-testid="dashboard-day-picker" />
                        </label>
                    }
                    else
                    {
                        <div class="od-range-fields">
                            <label class="od-date-field">
                                <span>@UiStrings.OperationsDashboard.FromDate</span>
                                <RadzenDatePicker TValue="DateTime?"
                                                  Value="@selectedFromDate"
                                                  Change="@OnFromDateChangedAsync"
                                                  DateFormat="dd MMM yyyy"
                                                  ShowTime="false"
                                                  AllowClear="false"
                                                  Placeholder="@UiStrings.OperationsDashboard.FromDate"
                                                  aria-label="@UiStrings.OperationsDashboard.FromDate"
                                                  class="od-date-picker"
                                                  data-testid="dashboard-from-picker" />
                            </label>
                            <label class="od-date-field">
                                <span>@UiStrings.OperationsDashboard.ToDate</span>
                                <RadzenDatePicker TValue="DateTime?"
                                                  Value="@selectedToDate"
                                                  Change="@OnToDateChangedAsync"
                                                  DateFormat="dd MMM yyyy"
                                                  ShowTime="false"
                                                  AllowClear="false"
                                                  Placeholder="@UiStrings.OperationsDashboard.ToDate"
                                                  aria-label="@UiStrings.OperationsDashboard.ToDate"
                                                  class="od-date-picker"
                                                  data-testid="dashboard-to-picker" />
                            </label>
                        </div>
                    }
                </div>

                <label class="od-dimension-filter">
                    <span><RadzenIcon Icon="connecting_airports" /> @UiStrings.OperationsDashboard.Stations</span>
                    <RadzenDropDown TValue="IEnumerable<Guid>"
                                    Value="@selectedStationIds"
                                    ValueChanged="@OnStationSelectionChangedAsync"
                                    Data="@stationOptions"
                                    TextProperty="Label"
                                    ValueProperty="Id"
                                    Multiple="true"
                                    Chips="false"
                                    MaxSelectedLabels="1"
                                    SelectedItemsText="@UiStrings.OperationsDashboard.ItemsSelected"
                                    AllowClear="true"
                                    AllowFiltering="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Placeholder="@UiStrings.OperationsDashboard.AllStations"
                                    aria-label="@UiStrings.OperationsDashboard.Stations"
                                    class="od-select"
                                    data-testid="dashboard-station-filter" />
                </label>

                <label class="od-dimension-filter">
                    <span><RadzenIcon Icon="airlines" /> @UiStrings.OperationsDashboard.Customers</span>
                    <RadzenDropDown TValue="IEnumerable<Guid>"
                                    Value="@selectedCustomerIds"
                                    ValueChanged="@OnCustomerSelectionChangedAsync"
                                    Data="@customerOptions"
                                    TextProperty="Label"
                                    ValueProperty="Id"
                                    Multiple="true"
                                    Chips="false"
                                    MaxSelectedLabels="1"
                                    SelectedItemsText="@UiStrings.OperationsDashboard.ItemsSelected"
                                    AllowClear="true"
                                    AllowFiltering="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Placeholder="@UiStrings.OperationsDashboard.AllCustomers"
                                    aria-label="@UiStrings.OperationsDashboard.Customers"
                                    class="od-select"
                                    data-testid="dashboard-customer-filter" />
                </label>

                <label class="od-dimension-filter">
                    <span><RadzenIcon Icon="engineering" /> @UiStrings.OperationsDashboard.PerformedServices</span>
                    <RadzenDropDown TValue="IEnumerable<Guid>"
                                    Value="@selectedServiceIds"
                                    ValueChanged="@OnServiceSelectionChangedAsync"
                                    Data="@serviceOptions"
                                    TextProperty="Label"
                                    ValueProperty="Id"
                                    Multiple="true"
                                    Chips="false"
                                    MaxSelectedLabels="1"
                                    SelectedItemsText="@UiStrings.OperationsDashboard.ItemsSelected"
                                    AllowClear="true"
                                    AllowFiltering="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Placeholder="@UiStrings.OperationsDashboard.AllServices"
                                    aria-label="@UiStrings.OperationsDashboard.PerformedServices"
                                    class="od-select"
                                    data-testid="dashboard-service-filter" />
                </label>

                <button type="button"
                        class="od-clear-button"
                        disabled="@(!HasActiveDimensionFilters || isRefreshing)"
                        @onclick="ClearDimensionFiltersAsync">
                    <RadzenIcon Icon="filter_alt_off" />
                    <span>@UiStrings.OperationsDashboard.ClearFilters</span>
                </button>
            </div>
        </section>

        @if (isInitialLoading)
        {
            <div class="od-loading" aria-label="@UiStrings.Common.Loading">
                <div class="od-skeleton od-skeleton--status"></div>
                <div class="od-skeleton-grid">
                    <div class="od-skeleton"></div>
                    <div class="od-skeleton"></div>
                    <div class="od-skeleton"></div>
                </div>
            </div>
        }
        else if (dashboard is null)
        {
            <ErrorState Message="@UiStrings.OperationsDashboard.DataUnavailable" OnRetry="@RefreshEverythingAsync" />
        }
        else
        {
            @if (dashboardLoadError)
            {
                <div class="od-stale-warning" role="status">
                    <RadzenIcon Icon="cloud_off" />
                    <span>@UiStrings.OperationsDashboard.StaleWarning</span>
                    <button type="button" @onclick="RefreshEverythingAsync">@UiStrings.OperationsDashboard.Retry</button>
                </div>
            }

            <section class="od-status-grid" aria-label="@UiStrings.OperationsDashboard.FlightStatus">
                <article class="od-total-card">
                    <span class="od-total-icon"><RadzenIcon Icon="flight_takeoff" /></span>
                    <div>
                        <small>@UiStrings.OperationsDashboard.TotalFlights</small>
                        <strong>@FormatCount(dashboard.TotalFlights)</strong>
                        <span>@RangeSummary</span>
                    </div>
                    <div class="od-total-secondary">
                        <strong>@FormatCount(dashboard.FlightsWithPerformedServices)</strong>
                        <span>@UiStrings.OperationsDashboard.FlightsWithPerformedServices</span>
                    </div>
                </article>

                @foreach (var status in StatusCards)
                {
                    <article class="@($"od-status-card od-status-card--{status.Tone}")" @key="status.Status">
                        <div class="od-status-heading">
                            <span><RadzenIcon Icon="@status.Icon" /></span>
                            <small>@status.Label</small>
                        </div>
                        <div class="od-status-value">
                            <strong>@FormatCount(status.Count)</strong>
                            <span>@FormatPercentage(status.Percentage)</span>
                        </div>
                        <progress value="@status.Percentage" max="100">@FormatPercentage(status.Percentage)</progress>
                    </article>
                }
            </section>

            <section class="od-chart-grid od-chart-grid--primary" aria-label="@UiStrings.OperationsDashboard.FlightDistribution">
                <DashboardPieChart Title="@UiStrings.OperationsDashboard.StationDistribution"
                                   Description="@UiStrings.OperationsDashboard.StationDistributionDescription"
                                   Icon="connecting_airports"
                                   Items="@dashboard.Stations"
                                   Tone="blue"
                                   Fills="@StationFills"
                                   TotalLabel="@UiStrings.OperationsDashboard.Flights"
                                   FlightsLabel="@UiStrings.OperationsDashboard.Flights"
                                   OtherLabel="@UiStrings.OperationsDashboard.Other"
                                   EmptyText="@UiStrings.OperationsDashboard.NoMatchingActivity" />

                <DashboardPieChart Title="@UiStrings.OperationsDashboard.LandingMode"
                                   Description="@UiStrings.OperationsDashboard.LandingModeDescription"
                                   Icon="support_agent"
                                   Items="@dashboard.ServiceCategories"
                                   Tone="teal"
                                   Fills="@LandingModeFills"
                                   TotalLabel="@UiStrings.OperationsDashboard.DesignatedFlights"
                                   FlightsLabel="@UiStrings.OperationsDashboard.Flights"
                                   PerLandingLabel="@UiStrings.OperationsDashboard.PerLanding"
                                   OnCallLabel="@UiStrings.OperationsDashboard.OnCall"
                                   EmptyText="@UiStrings.OperationsDashboard.NoLandingModeFlights" />

                <DashboardPieChart Title="@UiStrings.OperationsDashboard.OperationTypeDistribution"
                                   Description="@UiStrings.OperationsDashboard.OperationTypeDistributionDescription"
                                   Icon="category"
                                   Items="@dashboard.OperationTypes"
                                   Tone="violet"
                                   Fills="@OperationTypeFills"
                                   TotalLabel="@UiStrings.OperationsDashboard.Flights"
                                   FlightsLabel="@UiStrings.OperationsDashboard.Flights"
                                   EmptyText="@UiStrings.OperationsDashboard.NoMatchingActivity" />
            </section>

            <section class="od-insights-grid" aria-label="@UiStrings.OperationsDashboard.FlightTrends">
                <div class="od-trend-slot">
                    <DashboardFlightTrend Title="@UiStrings.OperationsDashboard.FlightTrends"
                                          Description="@UiStrings.OperationsDashboard.FlightTrendsDescription"
                                          Points="@dashboard.Timeline"
                                          Granularity="@dashboard.TimelineGranularity"
                                          RangeSummary="@RangeSummary"
                                          RangeKey="@TrendRangeKey"
                                          FlightsLabel="@UiStrings.OperationsDashboard.Flights"
                                          EmptyText="@UiStrings.OperationsDashboard.NoTrendData"
                                          ZoomHint="@UiStrings.OperationsDashboard.ZoomHint"
                                          PeriodLabel="@UiStrings.OperationsDashboard.PeriodShortcuts"
                                          TodayLabel="@UiStrings.OperationsDashboard.Today"
                                          LastMonthLabel="@UiStrings.OperationsDashboard.LastMonth"
                                          LastThreeMonthsLabel="@UiStrings.OperationsDashboard.LastThreeMonths"
                                          MaxLabel="@UiStrings.OperationsDashboard.Max"
                                          SelectedPreset="@selectedPreset"
                                          SelectedPresetChanged="@SelectPeriodPresetAsync"
                                          Busy="@isRefreshing" />
                </div>

                <DashboardPieChart Title="@UiStrings.OperationsDashboard.TopFourCustomers"
                                   Description="@UiStrings.OperationsDashboard.TopFourCustomersDescription"
                                   Icon="airlines"
                                   Items="@dashboard.Customers"
                                   Tone="primary"
                                   Fills="@CustomerFills"
                                   TotalLabel="@UiStrings.OperationsDashboard.Flights"
                                   FlightsLabel="@UiStrings.OperationsDashboard.Flights"
                                   OtherLabel="@UiStrings.OperationsDashboard.Other"
                                   EmptyText="@UiStrings.OperationsDashboard.NoMatchingActivity" />

                <DashboardPieChart Title="@UiStrings.OperationsDashboard.TopFourServices"
                                   Description="@UiStrings.OperationsDashboard.TopFourServicesDescription"
                                   Icon="engineering"
                                   Items="@dashboard.Services"
                                   Tone="amber"
                                   Fills="@ServiceFills"
                                   TotalLabel="@UiStrings.OperationsDashboard.TotalServiceUses"
                                   FlightsLabel="@UiStrings.OperationsDashboard.Flights"
                                   OtherLabel="@UiStrings.OperationsDashboard.Other"
                                   EmptyText="@UiStrings.OperationsDashboard.NoMatchingActivity" />
            </section>

            <section class="od-table-section" aria-labelledby="flight-table-title">
                <div class="od-table-heading">
                    <div>
                        <span>@UiStrings.OperationsDashboard.FlightRegister</span>
                        <h2 id="flight-table-title">@UiStrings.OperationsDashboard.FlightsTable</h2>
                        <p>@UiStrings.OperationsDashboard.FlightsTableDescription</p>
                    </div>
                    <div class="od-table-scope">
                        <RadzenIcon Icon="filter_alt" />
                        <span>@RangeSummary</span>
                    </div>
                </div>

                <DataListCard @ref="flightList" TItem="DashboardFlightRow"
                              Data="@flightRows" Count="@FlightTotalCount"
                              IsLoading="@isTableLoading" HasError="@tableLoadError"
                              ErrorMessage="@UiStrings.OperationsDashboard.TableUnavailable"
                              OnRetry="@ReloadFlightsAsync" LoadData="@LoadFlightsAsync"
                              PageSize="@currentPageSize" PageSizeChanged="@OnPageSizeChangedAsync"
                              ShowSearch="false" CountLabel="@UiStrings.OperationsDashboard.Flights"
                              EmptyText="@UiStrings.OperationsDashboard.NoFlights">
                    <Toolbar>
                        @if (CanExport)
                        {
                            <RowActionMenu Label="@UiStrings.OperationsDashboard.Export"
                                           BusyLabel="@UiStrings.OperationsDashboard.Exporting"
                                           ShowLabel="true" TriggerIcon="download" EndIcon="expand_more"
                                           Disabled="@(isTableLoading || tableLoadError || flightTotalCount <= 0)"
                                           Busy="@isExporting">
                                <RowAction Text="@UiStrings.Flights.ExcelWorkbook" Icon="table_view"
                                           OnClick="@(() => ExportAsync("xlsx"))" />
                                <RowAction Text="@UiStrings.Flights.CsvFile" Icon="csv"
                                           OnClick="@(() => ExportAsync("csv"))" />
                                <RowAction Text="@UiStrings.Flights.PdfReport" Icon="picture_as_pdf"
                                           OnClick="@(() => ExportAsync("pdf"))" />
                            </RowActionMenu>
                        }
                    </Toolbar>
                    <Columns>
                        <RadzenDataGridColumn TItem="DashboardFlightRow" Property="FlightNumber"
                                              Title="@UiStrings.OperationsDashboard.FlightNumber" Width="230px">
                            <Template Context="flight">
                                <div class="od-flight-cell">
                                    <span><RadzenIcon Icon="flight" /></span>
                                    <div>
                                        <strong>@DisplayFlightNumber(flight)</strong>
                                        <small>STA @DateTimeDisplay(flight.ScheduledArrivalUtc) UTC</small>
                                    </div>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="DashboardFlightRow" Property="CustomerName"
                                              Title="@UiStrings.OperationsDashboard.Customer" Width="120px">
                            <Template Context="flight">
                                <strong class="od-code-cell">@DisplayCode(flight.CustomerIataCode)</strong>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="DashboardFlightRow" Property="StationIata"
                                              Title="@UiStrings.OperationsDashboard.Station" Width="115px">
                            <Template Context="flight">
                                <strong class="od-code-cell">@flight.StationIata</strong>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="DashboardFlightRow" Property="OperationTypeName"
                                              Title="@UiStrings.OperationsDashboard.OperationType" Width="150px" />
                        <RadzenDataGridColumn TItem="DashboardFlightRow"
                                              Title="@UiStrings.OperationsDashboard.Services" Sortable="false" Width="230px">
                            <Template Context="flight">
                                @if (flight.PerformedServiceNames.Count == 0)
                                {
                                    <span class="od-no-services">@UiStrings.OperationsDashboard.NoPerformedServices</span>
                                }
                                else
                                {
                                    <div class="od-service-chips">
                                        @foreach (var service in flight.PerformedServiceNames.Take(2))
                                        {
                                            <span @key="service">@service</span>
                                        }
                                        @if (flight.PerformedServiceNames.Count > 2)
                                        {
                                            <span>+@(flight.PerformedServiceNames.Count - 2)</span>
                                        }
                                    </div>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="DashboardFlightRow" Property="Status"
                                              Title="@UiStrings.OperationsDashboard.Status" Width="145px">
                            <Template Context="flight">
                                <StatusBadge Label="@StatusLabel(flight.Status)" Tone="@StatusTone(flight.Status)" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </DataListCard>
            </section>
        }
    </main>
</RequirePermission>

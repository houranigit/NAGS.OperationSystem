@inject MasterDataApiClient MasterData
@inject DialogService DialogService

<RadzenTemplateForm TItem="SimpleCatalogModel" Data="@model" Submit="@SubmitAsync">
    <div class="mtf-form">
        <p class="mtf-intro os-muted">@SimpleCatalogText.Description(Kind)</p>
        @if (isSystem)
        {
            <p class="mtf-intro os-muted">Only the legacy system ID can be changed for this system record.</p>
        }
        <div class="mtf-section-line"><RadzenIcon Icon="@SimpleCatalogText.Icon(Kind)" /><span>@UiStrings.Common.Details</span></div>

        <div class="mtf-field-block">
            <label class="mtf-label">Name <span>*</span></label>
            <div class="mtf-input-wrap">
                <RadzenIcon Icon="@SimpleCatalogText.Icon(Kind)" class="mtf-field-icon" />
                <RadzenTextBox @bind-Value="model.Name" ReadOnly="@isSystem" Name="name" class="mtf-control mtf-control-icon" MaxLength="@NameMaxLength" />
            </div>
        </div>
        <div class="mtf-field-block">
            <label class="mtf-label">Description</label>
            <RadzenTextArea @bind-Value="model.Description" ReadOnly="@isSystem" Name="description" Rows="4" class="mtf-control" MaxLength="500" />
        </div>
        <div class="mtf-field-block">
            <label class="mtf-label">Legacy system ID</label>
            <RadzenTextBox @bind-Value="model.LegacySystemId" Name="legacySystemId" class="mtf-control" MaxLength="200" Placeholder="e.g. XYZ123" />
            <small class="os-muted">Optional ID from your old system, used in the flight Excel export.</small>
        </div>

        @if (SupportsCalculationType)
        {
            <div class="mtf-field-block">
                <label class="mtf-label">Usage calculation <span>*</span></label>
                <RadzenDropDown @bind-Value="model.CalculationType" Disabled="@isSystem" Data="@calculationTypes"
                                Name="calculationType" class="mtf-control" />
                <small class="os-muted">Quantity records an amount used. Duration records a from/to usage period, where the end can remain open.</small>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <DismissibleDialogMessage AlertStyle="AlertStyle.Danger" Title="Please fix the following errors before continuing"
                                      StateKey="@errorMessage" OnDismiss="@(() => errorMessage = null)">
                <ul><li>@errorMessage</li></ul>
            </DismissibleDialogMessage>
        }

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" class="mtf-actions">
            <RadzenButton Text="@UiStrings.Common.Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close(false))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="@(EntityId is null ? UiStrings.Common.Create : UiStrings.Common.Save)"
                          ButtonStyle="ButtonStyle.Primary" Disabled="@isSubmitting" />
        </RadzenStack>
    </div>
</RadzenTemplateForm>

@code {
    [Parameter] public SimpleCatalogKind Kind { get; set; }
    [Parameter] public Guid? EntityId { get; set; }

    private readonly IReadOnlyList<ResourceCalculationType> calculationTypes = Enum.GetValues<ResourceCalculationType>();
    private SimpleCatalogModel model = new();
    private string? rowVersion;
    private bool isSystem;
    private static readonly Guid UnknownMaterialId = new("70000000-0000-0000-0000-000000000001");
    private static readonly Guid UnknownGeneralSupportId = new("80000000-0000-0000-0000-000000000001");
    private bool isSubmitting;
    private string? errorMessage;

    private int NameMaxLength => Kind is SimpleCatalogKind.Materials or SimpleCatalogKind.GeneralSupports ? 200 : 100;
    private bool SupportsCalculationType => Kind is SimpleCatalogKind.Materials or SimpleCatalogKind.GeneralSupports;

    protected override async Task OnInitializedAsync()
    {
        if (EntityId is not { } id)
        {
            model.CalculationType = ResourceCalculationType.Quantity;
            return;
        }

        try
        {
            var detail = await LoadDetailAsync(id);
            model = new SimpleCatalogModel
            {
                Name = detail.Name,
                Description = detail.Description,
                LegacySystemId = detail.LegacySystemId,
                CalculationType = detail.CalculationType ?? ResourceCalculationType.Quantity
            };
            rowVersion = detail.RowVersion;
            isSystem = detail.IsSystem
                || (Kind == SimpleCatalogKind.Materials && detail.Id == UnknownMaterialId)
                || (Kind == SimpleCatalogKind.GeneralSupports && detail.Id == UnknownGeneralSupportId);
        }
        catch (ApiException ex)
        {
            errorMessage = ex.ToDisplayMessage(UiStrings.Common.SomethingWentWrong);
        }
    }

    private async Task SubmitAsync()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(model.Name))
        {
            errorMessage = "A name is required.";
            return;
        }

        isSubmitting = true;
        try
        {
            var name = model.Name.Trim();
            var description = string.IsNullOrWhiteSpace(model.Description) ? null : model.Description.Trim();
            var legacySystemId = string.IsNullOrWhiteSpace(model.LegacySystemId) ? null : model.LegacySystemId.Trim();

            if (EntityId is { } id)
                await UpdateAsync(id, name, description, legacySystemId ?? string.Empty);
            else
                await CreateAsync(name, description, legacySystemId);

            DialogService.Close(true);
        }
        catch (ApiException ex)
        {
            errorMessage = ex.ToDisplayMessage(UiStrings.Common.SomethingWentWrong);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private Task CreateAsync(string name, string? description, string? legacySystemId) => Kind switch
    {
        SimpleCatalogKind.Services => MasterData.CreateServiceAsync(new CreateServiceRequest(name, description, legacySystemId)),
        SimpleCatalogKind.OperationTypes => MasterData.CreateOperationTypeAsync(new CreateOperationTypeRequest(name, description, legacySystemId)),
        SimpleCatalogKind.Materials => MasterData.CreateMaterialAsync(
            new CreateMaterialRequest(name, description, model.CalculationType, legacySystemId)),
        SimpleCatalogKind.GeneralSupports => MasterData.CreateGeneralSupportAsync(
            new CreateGeneralSupportRequest(name, description, model.CalculationType, legacySystemId)),
        _ => Task.CompletedTask
    };

    private Task UpdateAsync(Guid id, string name, string? description, string legacySystemId) => Kind switch
    {
        SimpleCatalogKind.Services => MasterData.UpdateServiceAsync(id, new UpdateServiceRequest(name, description, legacySystemId), rowVersion ?? string.Empty),
        SimpleCatalogKind.OperationTypes => MasterData.UpdateOperationTypeAsync(id, new UpdateOperationTypeRequest(name, description, legacySystemId), rowVersion ?? string.Empty),
        SimpleCatalogKind.Materials => MasterData.UpdateMaterialAsync(
            id, new UpdateMaterialRequest(name, description, model.CalculationType, legacySystemId), rowVersion ?? string.Empty),
        SimpleCatalogKind.GeneralSupports => MasterData.UpdateGeneralSupportAsync(
            id, new UpdateGeneralSupportRequest(name, description, model.CalculationType, legacySystemId), rowVersion ?? string.Empty),
        _ => Task.CompletedTask
    };

    private async Task<SimpleCatalogDetail> LoadDetailAsync(Guid id) => Kind switch
    {
        SimpleCatalogKind.Services => ToDetail(await MasterData.GetServiceAsync(id)),
        SimpleCatalogKind.OperationTypes => ToDetail(await MasterData.GetOperationTypeAsync(id)),
        SimpleCatalogKind.Materials => ToDetail(await MasterData.GetMaterialAsync(id)),
        SimpleCatalogKind.GeneralSupports => ToDetail(await MasterData.GetGeneralSupportAsync(id)),
        _ => throw new InvalidOperationException("Unsupported catalog kind.")
    };

    private static SimpleCatalogDetail ToDetail(ServiceDetail value) =>
        new(value.Id, value.Name, value.Description, value.IsActive, value.IsSystem,
            value.CreatedAtUtc, value.UpdatedAtUtc, value.RowVersion, null, value.LegacySystemId);

    private static SimpleCatalogDetail ToDetail(OperationTypeDetail value) =>
        new(value.Id, value.Name, value.Description, value.IsActive, value.IsSystem,
            value.CreatedAtUtc, value.UpdatedAtUtc, value.RowVersion, null, value.LegacySystemId);

    private static SimpleCatalogDetail ToDetail(MaterialDetail value) =>
        new(value.Id, value.Name, value.Description, value.IsActive, false,
            value.CreatedAtUtc, value.UpdatedAtUtc, value.RowVersion, value.CalculationType, value.LegacySystemId);

    private static SimpleCatalogDetail ToDetail(GeneralSupportDetail value) =>
        new(value.Id, value.Name, value.Description, value.IsActive, false,
            value.CreatedAtUtc, value.UpdatedAtUtc, value.RowVersion, value.CalculationType, value.LegacySystemId);

    private sealed class SimpleCatalogModel
    {
        public string? LegacySystemId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public ResourceCalculationType CalculationType { get; set; } = ResourceCalculationType.Quantity;
    }
}

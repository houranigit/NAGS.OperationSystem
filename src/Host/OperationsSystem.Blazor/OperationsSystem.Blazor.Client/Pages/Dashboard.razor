@page "/"

<PageTitle>@UiStrings.Nav.Dashboard</PageTitle>

<RequireAuth>
    @if (Auth.User is { } user && CanAccessRootDashboard)
    {
        <main class="os-home-dashboard">
            <section class="os-home-hero">
                <div class="os-home-hero-copy">
                    <p class="os-home-eyebrow"><RadzenIcon Icon="space_dashboard" />Workspace overview</p>
                    <h1>Welcome back, @FirstName</h1>
                    <p>See a concise snapshot, then move directly to the tools available for your role.</p>
                    <div class="os-home-identity">
                        <span><RadzenIcon Icon="calendar_today" />@TodayLabel</span>
                        <span><RadzenIcon Icon="verified_user" />@user.RoleName</span>
                    </div>
                </div>

                <aside class="os-home-quick-actions" aria-label="Quick actions">
                    <span class="os-home-quick-label">Quick actions</span>
                    @foreach (var action in QuickActions)
                    {
                        <button @key="action.Key" type="button" class="@QuickActionClass(action.IsPrimary)"
                                @onclick="() => NavigateTo(action.Href)">
                            <RadzenIcon Icon="@action.Icon" />
                            <span>@action.Label</span>
                            <RadzenIcon Icon="arrow_forward" class="os-home-action-arrow" />
                        </button>
                    }
                </aside>
            </section>

            @if (HasSummaryAccess)
            {
                <section class="os-home-section" aria-labelledby="home-snapshot-heading">
                    <header class="os-home-section-heading">
                        <div>
                            <p class="os-home-eyebrow">At a glance</p>
                            <h2 id="home-snapshot-heading">Data snapshot</h2>
                            <p>Loaded once for this visit. Open the relevant feature for current operational detail.</p>
                        </div>
                        @if (snapshotGeneratedAtUtc is { } generatedAt)
                        {
                            <span class="os-home-snapshot-time"><RadzenIcon Icon="schedule" />@SnapshotTime(generatedAt)</span>
                        }
                    </header>

                    @if (isSummaryLoading)
                    {
                        <div class="os-home-summary-grid" aria-label="@UiStrings.Common.Loading">
                            @for (var index = 0; index < SummaryPlaceholderCount; index++)
                            {
                                <div @key="index" class="os-home-summary-card os-home-summary-card--loading"></div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="os-home-summary-grid">
                            @foreach (var metric in SummaryMetrics)
                            {
                                <article @key="metric.Key" class="@SummaryCardClass(metric.Tone)">
                                    <span class="os-home-summary-icon"><RadzenIcon Icon="@metric.Icon" /></span>
                                    <div>
                                        <span>@metric.Label</span>
                                        <strong>@FormatCount(metric.Value)</strong>
                                        <small>@metric.Hint</small>
                                    </div>
                                </article>
                            }
                        </div>

                        @if (summaryHasError)
                        {
                            <div class="os-home-notice" role="status">
                                <RadzenIcon Icon="info" />
                                <span>Some snapshot totals are unavailable. Your feature links and permissions are unaffected.</span>
                            </div>
                        }
                    }
                </section>
            }

            <section class="os-home-section" aria-labelledby="home-features-heading">
                <header class="os-home-section-heading">
                    <div>
                        <p class="os-home-eyebrow">Your workspace</p>
                        <h2 id="home-features-heading">Features you can access</h2>
                        <p>These shortcuts reflect your current permissions.</p>
                    </div>
                </header>

                <div class="os-home-feature-grid">
                    @foreach (var feature in FeatureCards)
                    {
                        <button @key="feature.Key" type="button" class="os-home-feature-card"
                                @onclick="() => NavigateTo(feature.Href)">
                            <span class="@FeatureIconClass(feature.Tone)"><RadzenIcon Icon="@feature.Icon" /></span>
                            <span class="os-home-feature-copy">
                                <strong>@feature.Title</strong>
                                <span>@feature.Description</span>
                                <small>@feature.ActionLabel <RadzenIcon Icon="arrow_forward" /></small>
                            </span>
                        </button>
                    }
                </div>
            </section>
        </main>
    }
</RequireAuth>

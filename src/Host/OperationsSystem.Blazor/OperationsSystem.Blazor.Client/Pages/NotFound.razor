@page "/not-found"

<PageTitle>Not found</PageTitle>

<PageHeader Title="Page not found">
    <Actions>
        <RadzenButton Text="Back to dashboard" ButtonStyle="ButtonStyle.Primary" Icon="home"
                      Click="@(() => Navigation.NavigateTo("/"))" />
    </Actions>
</PageHeader>

<p class="os-muted">The content you are looking for does not exist.</p>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;
}

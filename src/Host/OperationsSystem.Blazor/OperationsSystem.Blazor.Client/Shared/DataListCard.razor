@typeparam TItem where TItem : notnull
@using Radzen
@inject GridPreferences GridPrefs
@inject AuthSession Auth

@*
    Reusable list shell for every grid page in the portal.
    - Toolbar: search box (left) + filter slot (left) + result count (right) + extra actions slot.
    - Server-side paging via LoadData/Count.
    - Row click highlights only (single selection); navigation/actions live in the pinned last column.
*@

<div class="os-list-card">
    @if (ShowToolbar && PageSizeReady)
    {
        <div class="@ToolbarCssClass">
            <div class="os-list-toolbar-main">
                <div class="os-list-toolbar-filters">
                    <span class="os-count-badge" aria-live="polite">
                        <strong>@Count.ToString("N0")</strong>
                        <span>@CountLabel</span>
                    </span>

                    @if (ShowSearch)
                    {
                        <div class="os-search">
                            <RadzenFormField Variant="Variant.Outlined">
                                <Start>
                                    <RadzenIcon Icon="search" />
                                </Start>
                                <ChildContent>
                                    <RadzenTextBox Value="@SearchValue"
                                                   Change="@OnSearchChangedAsync"
                                                   Placeholder="@(SearchPlaceholder ?? UiStrings.Common.Search)"
                                                   aria-label="@(SearchPlaceholder ?? UiStrings.Common.Search)" />
                                </ChildContent>
                                <End>
                                    @if (!string.IsNullOrEmpty(SearchValue))
                                    {
                                        <button type="button" class="os-search-clear" aria-label="@UiStrings.Common.Cancel" @onclick="ClearSearchAsync">
                                            <RadzenIcon Icon="close" />
                                        </button>
                                    }
                                </End>
                            </RadzenFormField>
                        </div>
                    }

                    @if (!UseCollapsibleFilters)
                    {
                        @Filters
                    }

                    @if (HasFilterPanel || HasToolbarPanel)
                    {
                        <div class="os-list-toolbar-toggles">
                            @if (HasFilterPanel)
                            {
                                <button type="button" class="@ToggleCssClass(filtersExpanded)" aria-expanded="@(filtersExpanded ? "true" : "false")" @onclick="ToggleFilters">
                                    <RadzenIcon Icon="tune" />
                                    <span>@FilterToggleText</span>
                                    @if (ActiveFilterCount > 0)
                                    {
                                        <span class="os-filter-count">@ActiveFilterCount</span>
                                    }
                                    <span class="os-filter-toggle-chevron">
                                        <RadzenIcon Icon="expand_more" />
                                    </span>
                                </button>
                            }

                            @if (HasToolbarPanel)
                            {
                                <button type="button" class="@ToggleCssClass(toolbarPanelExpanded)" aria-expanded="@(toolbarPanelExpanded ? "true" : "false")"
                                        aria-controls="@toolbarPanelId" @onclick="ToggleToolbarPanel">
                                    <RadzenIcon Icon="@ToolbarPanelIcon" />
                                    <span>@ToolbarPanelLabel</span>
                                    <span class="os-filter-toggle-chevron">
                                        <RadzenIcon Icon="expand_more" />
                                    </span>
                                </button>
                            }
                        </div>

                        @if (HasFilterPanel && OnClearFilters.HasDelegate && ActiveFilterCount > 0)
                        {
                            <button type="button" class="os-clear-filters" @onclick="ClearFiltersAsync">
                                <RadzenIcon Icon="filter_alt_off" />
                                <span>@ClearFiltersText</span>
                            </button>
                        }
                    }
                </div>

                <div class="os-list-toolbar-meta">
                    @Toolbar
                </div>
            </div>

            @if (HasFilterPanel || HasToolbarPanel)
            {
                <div class="os-list-toolbar-panels">
                    @if (HasFilterPanel)
                    {
                        <div class="@PanelCssClass(filtersExpanded)">
                            <div class="os-list-filter-panel-inner">
                                @Filters
                            </div>
                        </div>
                    }
                    @if (HasToolbarPanel)
                    {
                        <div id="@toolbarPanelId" class="@PanelCssClass(toolbarPanelExpanded)" inert="@(!toolbarPanelExpanded)">
                            <div class="os-list-filter-panel-inner">
                                @ToolbarPanel
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (!PageSizeReady)
    {
        <LoadingCard />
    }
    else if (HasError)
    {
        <div class="os-list-state">
            <ErrorState Message="@(ErrorMessage ?? UiStrings.Errors.LoadFailed)" OnRetry="@OnRetry" />
        </div>
    }
    else
    {
        <div class="os-list-grid">
            <RadzenDataGrid @ref="grid" TItem="TItem" Data="@Data" Count="@Count" IsLoading="@IsLoading"
                            AllowPaging="true" PageSize="@PageSize" PageSizeChanged="@OnPageSizeChangedAsync"
                            PageSizeOptions="@PageSizeOptions" PageSizeText="@TotalCountText"
                            PagerHorizontalAlign="HorizontalAlign.Left" PagerAlwaysVisible="true"
                            AllowColumnResize="@columnPreferencesReady" AllowColumnReorder="@columnPreferencesReady"
                            Settings="@columnSettings" SettingsChanged="@GridSettingsChanged"
                            ColumnResized="@MarkColumnLayoutChanged" ColumnReordered="@MarkColumnLayoutChanged"
                            ColumnReordering="@KeepFixedColumnInPlace"
                            PageNumbersCount="5" ShowPagingSummary="true" PagingSummaryFormat="@(PageSizeOptions.Any() ? PagingSummaryFormat : TotalCountText)"
                            AllowSorting="@AllowSorting" LoadData="@LoadData" EmptyText="@(EmptyText ?? UiStrings.Common.NoData)"
                            Template="@RowDetail" ShowExpandColumn="false" ExpandMode="DataGridExpandMode.Single"
                            RowRender="@RowRender" CellRender="@CellRender"
                            SelectionMode="DataGridSelectionMode.Single" @bind-Value="@selection"
                            GridLines="DataGridGridLines.Horizontal">
                <Columns>
                    @Columns
                    @if (ShowActionsColumn && RowActions is not null)
                    {
                        <RadzenDataGridColumn TItem="TItem" UniqueID="actions" Title="@(ActionsTitle ?? UiStrings.Common.Actions)"
                                              Sortable="false" Filterable="false" Resizable="false" Reorderable="false"
                                              Frozen="true" FrozenPosition="FrozenColumnPosition.Right"
                                              Width="@ActionsWidth" TextAlign="TextAlign.Center" HeaderCssClass="os-actions-header">
                            <Template Context="item">
                                <div class="os-row-actions" @onclick:stopPropagation="true">
                                    @RowActions(item)
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                    }
                </Columns>
            </RadzenDataGrid>
        </div>
    }
</div>

@code {
    private RadzenDataGrid<TItem>? grid;
    private IList<TItem> selection = [];
    private DataGridSettings? columnSettings;
    private bool columnPreferencesRequested;
    private bool columnPreferencesReady;
    private bool columnLayoutChanged;

    /// <summary>Column definitions (RadzenDataGridColumn) for the concrete <typeparamref name="TItem"/>.</summary>
    [Parameter] public RenderFragment? Columns { get; set; }

    /// <summary>Optional contextual content shown below a row opened by the page.</summary>
    [Parameter] public RenderFragment<TItem>? RowDetail { get; set; }

    [Parameter] public Action<RowRenderEventArgs<TItem>>? RowRender { get; set; }

    [Parameter] public Action<DataGridCellRenderEventArgs<TItem>>? CellRender { get; set; }

    /// <summary>Cell content for the pinned trailing actions column. Omit to hide the column.</summary>
    [Parameter] public RenderFragment<TItem>? RowActions { get; set; }

    /// <summary>Allows a supplied actions template to be hidden without rebuilding the surrounding list markup.</summary>
    [Parameter] public bool ShowActionsColumn { get; set; } = true;

    [Parameter] public bool ShowToolbar { get; set; } = true;

    /// <summary>Extra controls rendered on the right of the toolbar, before the count badge.</summary>
    [Parameter] public RenderFragment? Toolbar { get; set; }

    /// <summary>Optional second collapsible row. Supply a label to show its toggle beside Filters.</summary>
    [Parameter] public RenderFragment? ToolbarPanel { get; set; }
    [Parameter] public string? ToolbarPanelLabel { get; set; }
    [Parameter] public string ToolbarPanelIcon { get; set; } = "expand_more";

    /// <summary>Filter controls (dropdowns) rendered beside the search box.</summary>
    [Parameter] public RenderFragment? Filters { get; set; }

    /// <summary>When true, filters move into an animated tray opened from the toolbar.</summary>
    [Parameter] public bool UseCollapsibleFilters { get; set; }

    /// <summary>Initial state for the optional filter tray.</summary>
    [Parameter] public bool FiltersInitiallyExpanded { get; set; }

    /// <summary>Number shown on the filter toggle when filters are active.</summary>
    [Parameter] public int ActiveFilterCount { get; set; }

    [Parameter] public string FilterToggleText { get; set; } = "Filters";
    [Parameter] public string ClearFiltersText { get; set; } = "Clear filters";
    [Parameter] public EventCallback OnClearFilters { get; set; }

    [Parameter] public IEnumerable<TItem>? Data { get; set; }
    [Parameter] public int Count { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool HasError { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }

    [Parameter] public EventCallback<LoadDataArgs> LoadData { get; set; }

    /// <summary>Current page size. Bind this to a persisted value to restore the user's choice.</summary>
    [Parameter] public int PageSize { get; set; } = GridPreferences.DefaultPageSize;

    /// <summary>Defers grid creation while the page reads a saved size.</summary>
    [Parameter] public bool PageSizeReady { get; set; } = true;

    /// <summary>Raised when the user picks a different page size from the pager dropdown.</summary>
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    /// <summary>Page-size choices shown in the pager dropdown.</summary>
    [Parameter] public IEnumerable<int> PageSizeOptions { get; set; } = new[] { 10, 25, 50, 100 };

    /// <summary>Overrides the localized record total shown in the pager.</summary>
    [Parameter] public string? PageSizeText { get; set; }

    private string TotalCountText => PageSizeText ?? UiStrings.Common.RecordTotal(Count);

    /// <summary>Opts in to resizable, reorderable columns with an account-specific saved layout.</summary>
    [Parameter] public string? ColumnLayoutKey { get; set; }

    /// <summary>Looks for legacy layouts in order to restore saved column widths when the current layout has no preferences.</summary>
    [Parameter] public IReadOnlyList<string> PreviousColumnLayoutKeys { get; set; } = [];

    [Parameter] public bool AllowSorting { get; set; } = true;

    [Parameter] public bool ShowSearch { get; set; } = true;
    [Parameter] public string SearchValue { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SearchValueChanged { get; set; }
    [Parameter] public string? SearchPlaceholder { get; set; }

    /// <summary>Raised when the user submits the search (Enter/blur) or clears it.</summary>
    [Parameter] public EventCallback OnSearch { get; set; }

    [Parameter] public string? EmptyText { get; set; }
    [Parameter] public string CountLabel { get; set; } = string.Empty;
    [Parameter] public string? PagingSummaryFormat { get; set; } = "Page {0} of {1}";

    [Parameter] public string? ActionsTitle { get; set; }
    [Parameter] public string ActionsWidth { get; set; } = "84px";

    private bool filterStateInitialized;
    private bool filtersExpanded;
    private bool toolbarPanelExpanded;
    private readonly string toolbarPanelId = $"list-toolbar-panel-{Guid.NewGuid():N}";

    protected override void OnParametersSet()
    {
        if (filterStateInitialized)
            return;

        filtersExpanded = FiltersInitiallyExpanded;
        filterStateInitialized = true;
    }

    /// <summary>
    /// Reloads the grid from the first page (use after search/filter changes or create/edit/delete).
    /// Falls back to invoking <see cref="LoadData"/> directly when the grid is hidden (e.g. error state).
    /// </summary>
    public async Task ReloadAsync()
    {
        if (!PageSizeReady)
            return;

        if (!HasError && grid is not null)
            await grid.FirstPage(true);
        else
            await LoadData.InvokeAsync(new LoadDataArgs { Skip = 0, Top = PageSize });
    }

    public Task OpenRowDetailAsync(TItem item) => grid is not null && !grid.IsRowExpanded(item)
        ? grid.ExpandRow(item)
        : Task.CompletedTask;

    public Task CloseRowDetailAsync(TItem item) => grid is not null && grid.IsRowExpanded(item)
        ? grid.CollapseRows([item])
        : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!PageSizeReady || columnPreferencesRequested || ColumnLayoutKey is not { } key || Auth.User is not { Id: var userId })
            return;

        columnPreferencesRequested = true;
        var savedLayout = await GridPrefs.GetColumnLayoutAsync(key, userId);
        foreach (var previousKey in PreviousColumnLayoutKeys)
        {
            if (savedLayout is not null)
                break;

            savedLayout = await GridPrefs.GetColumnLayoutAsync(previousKey, userId);
            if (savedLayout is not null)
            {
                foreach (var column in savedLayout.Columns)
                    column.OrderIndex = null;
            }
        }

        if (savedLayout is not null)
        {
            // A sort or page change during the read remains in effect.
            savedLayout.CurrentPage = columnSettings?.CurrentPage;
            savedLayout.PageSize = columnSettings?.PageSize;
            foreach (var column in savedLayout.Columns)
            {
                var current = columnSettings?.Columns.FirstOrDefault(setting => GridPreferences.ColumnId(setting) == column.UniqueID);
                column.SortOrder = current?.SortOrder;
                column.SortIndex = current?.SortIndex;
            }

            columnSettings = savedLayout;
        }

        columnPreferencesReady = true;
        StateHasChanged();
    }

    private EventCallback<DataGridSettings> GridSettingsChanged => ColumnLayoutKey is null
        ? default
        : EventCallback.Factory.Create<DataGridSettings>(this, OnGridSettingsChangedAsync);

    private void MarkColumnLayoutChanged() => columnLayoutChanged = true;

    private static void KeepFixedColumnInPlace(DataGridColumnReorderingEventArgs<TItem> args) =>
        args.Cancel = args.ToColumn is { Frozen: true } or { Reorderable: false };

    private async Task OnGridSettingsChangedAsync(DataGridSettings settings)
    {
        columnSettings = settings;
        if (!columnLayoutChanged || ColumnLayoutKey is not { } key || Auth.User is not { Id: var userId })
            return;

        columnLayoutChanged = false;
        await GridPrefs.SetColumnLayoutAsync(key, userId, settings);
    }

    private async Task OnPageSizeChangedAsync(int value)
    {
        PageSize = value;
        await PageSizeChanged.InvokeAsync(value);
    }

    private async Task OnSearchChangedAsync(string value)
    {
        SearchValue = value;
        await SearchValueChanged.InvokeAsync(value);
        await OnSearch.InvokeAsync();
    }

    private async Task ClearSearchAsync()
    {
        SearchValue = string.Empty;
        await SearchValueChanged.InvokeAsync(string.Empty);
        await OnSearch.InvokeAsync();
    }

    private void ToggleFilters() => filtersExpanded = !filtersExpanded;
    private void ToggleToolbarPanel() => toolbarPanelExpanded = !toolbarPanelExpanded;

    private async Task ClearFiltersAsync() => await OnClearFilters.InvokeAsync();

    private string ToolbarCssClass =>
        UseCollapsibleFilters || HasToolbarPanel ? "os-list-toolbar os-list-toolbar--collapsible" : "os-list-toolbar";

    private bool HasFilterPanel => UseCollapsibleFilters && Filters is not null;
    private bool HasToolbarPanel => ToolbarPanel is not null && !string.IsNullOrWhiteSpace(ToolbarPanelLabel);

    private static string PanelCssClass(bool expanded) =>
        expanded ? "os-list-filter-panel is-expanded" : "os-list-filter-panel";

    private static string ToggleCssClass(bool expanded) =>
        expanded ? "os-filter-toggle is-expanded" : "os-filter-toggle";
}

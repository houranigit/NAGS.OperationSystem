<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.*.local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OperationsSystem.Blazor.Client\OperationsSystem.Blazor.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\docs\user-manual\release\nags-operations-field-guide.html"
                      LogicalName="OperationsSystem.Blazor.UserManual.html" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>OperationsSystem.Blazor.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The SDK omits the initializer manifest when there are no modules. Publishing an
       empty list ensures copy-and-replace deployments overwrite obsolete manifests,
       such as the Hot Reload initializer left behind by an earlier release. -->
  <Target Name="EnsurePortalPublishInitializerManifest"
          AfterTargets="Publish"
          DependsOnTargets="ResolveJSModuleManifestPublishConfiguration"
          Condition="'$(IsPublishable)' == 'true' and '$(GenerateJSModuleManifest)' == 'true'">
    <WriteLinesToFile File="$(PublishDir)wwwroot/$(JSModuleManifestRelativePath)"
                      Lines="[]"
                      Overwrite="true"
                      Encoding="UTF-8"
                      Condition="'@(_ExistingPublishJSModules)' == ''" />
    <ItemGroup Condition="'@(_ExistingPublishJSModules)' == ''">
      <FileWrites Include="$(PublishDir)wwwroot/$(JSModuleManifestRelativePath)" />
    </ItemGroup>
  </Target>

</Project>
